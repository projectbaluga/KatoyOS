+        g.setColorAt(0, self._colors[0])
+        g.setColorAt(1, self._colors[1])
+        p.setPen(QPen(QBrush(g), 1))
+        p.setFont(self.font())
+        p.drawText(self.rect(), int(self._align.value if hasattr(self._align, "value") else self._align), self._text)
