+# ── Vector icons (no icon theme / emoji font dependency) ──────────────────────
+def make_icon(kind, color="#ffffff", size=64):
+    pm = QPixmap(size, size)
+    pm.fill(Qt.GlobalColor.transparent)
+    p = QPainter(pm)
+    p.setRenderHint(QPainter.RenderHint.Antialiasing)
+    col = QColor(color)
+    s = float(size)
+    p.setPen(QPen(col, s * 0.085, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin))
+    p.setBrush(Qt.BrushStyle.NoBrush)
+
+    def P(x, y):
+        return QPointF(x * s, y * s)
+
+    def line(x1, y1, x2, y2):
+        p.drawLine(P(x1, y1), P(x2, y2))
+
+    def poly(*pts):
+        p.drawPolygon(QPolygonF([P(x, y) for x, y in pts]))
+
+    if kind == "play":
+        p.setBrush(col)
+        poly((.33, .20), (.33, .80), (.80, .50))
+    elif kind == "pause":
+        p.setBrush(col)
+        p.drawRoundedRect(QRectF(.27 * s, .20 * s, .17 * s, .60 * s), .05 * s, .05 * s)
+        p.drawRoundedRect(QRectF(.56 * s, .20 * s, .17 * s, .60 * s), .05 * s, .05 * s)
+    elif kind == "next":
+        p.setBrush(col)
+        poly((.24, .22), (.24, .78), (.66, .50))
+        line(.76, .22, .76, .78)
+    elif kind == "back":
+        line(.78, .50, .24, .50)
+        p.drawPolyline(QPolygonF([P(.46, .26), P(.22, .50), P(.46, .74)]))
+    elif kind == "gear":
+        p.drawEllipse(P(.5, .5), s * .15, s * .15)
+        p.drawEllipse(P(.5, .5), s * .29, s * .29)
+        for i in range(8):
+            a = i * math.pi / 4
+            line(.5 + .31 * math.cos(a), .5 + .31 * math.sin(a), .5 + .41 * math.cos(a), .5 + .41 * math.sin(a))
+    elif kind == "refresh":
+        p.drawArc(QRectF(.2 * s, .2 * s, .6 * s, .6 * s), 30 * 16, 290 * 16)
+        p.setBrush(col)
+        poly((.80, .16), (.82, .46), (.54, .36))
+    elif kind == "mic":
+        p.setBrush(col)
+        p.drawRoundedRect(QRectF(.38 * s, .10 * s, .24 * s, .44 * s), .12 * s, .12 * s)
+        p.setBrush(Qt.BrushStyle.NoBrush)
+        p.drawArc(QRectF(.26 * s, .26 * s, .48 * s, .44 * s), 180 * 16, 180 * 16)
+        line(.5, .70, .5, .86)
+        line(.36, .87, .64, .87)
+    elif kind == "search":
+        p.drawEllipse(P(.44, .44), s * .22, s * .22)
+        line(.61, .61, .82, .82)
+    elif kind == "queue":
+        line(.20, .28, .80, .28)
+        line(.20, .50, .62, .50)
+        line(.20, .72, .50, .72)
+        p.setBrush(col)
+        poly((.68, .60), (.68, .84), (.86, .72))
+    elif kind == "plus":
+        line(.5, .22, .5, .78)
+        line(.22, .5, .78, .5)
+    elif kind == "minus":
+        line(.22, .5, .78, .5)
+    elif kind == "up":
+        p.drawPolyline(QPolygonF([P(.24, .62), P(.50, .36), P(.76, .62)]))
+    elif kind == "down":
+        p.drawPolyline(QPolygonF([P(.24, .38), P(.50, .64), P(.76, .38)]))
+    elif kind == "note":
+        p.setBrush(col)
+        p.drawEllipse(P(.34, .72), s * .15, s * .11)
+        line(.47, .70, .47, .18)
+        line(.47, .18, .78, .30)
+    elif kind == "bookmark":
+        p.setBrush(col)
+        poly((.30, .14), (.70, .14), (.70, .86), (.50, .68), (.30, .86))
+    elif kind == "close":
+        line(.26, .26, .74, .74)
+        line(.74, .26, .26, .74)
+    p.end()
+    return QIcon(pm)
+
+
+def badge_pixmap(kind, size):
+    """Gradient rounded-square app badge with a white icon (header logo)."""
+    pm = QPixmap(size, size)
+    pm.fill(Qt.GlobalColor.transparent)
+    p = QPainter(pm)
+    p.setRenderHint(QPainter.RenderHint.Antialiasing)
+    g = QLinearGradient(0, 0, size, size)
+    g.setColorAt(0, COL_PINK)
+    g.setColorAt(1, COL_VIOLET)
+    p.setBrush(QBrush(g))
+    p.setPen(Qt.PenStyle.NoPen)
+    p.drawRoundedRect(QRectF(0, 0, size, size), size * .30, size * .30)
+    ic = make_icon(kind, "#ffffff", int(size * .62)).pixmap(int(size * .62), int(size * .62))
+    o = (size - ic.width()) // 2
+    p.drawPixmap(o, o, ic)
+    p.end()
+    return pm
+
