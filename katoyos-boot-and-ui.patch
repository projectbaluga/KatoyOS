+QSlider::handle:horizontal {{ width: {s(30)}px; height: {s(30)}px; margin: -{s(9)}px 0; border-radius: {s(15)}px; background: #ffffff; }}
+QSlider:focus::handle:horizontal {{ background: #22d3ee; }}
+"""
+
