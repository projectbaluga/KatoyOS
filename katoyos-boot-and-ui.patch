+class GradientLabel(QWidget):
+    """Text filled with a horizontal gradient (QLabel can't do that)."""
+
+    def __init__(self, text="", px=48, weight=QFont.Weight.ExtraBold, colors=(COL_PINK, COL_GOLD),
+                 align=Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, parent=None):
+        super().__init__(parent)
+        self._text = text
+        self._colors = colors
+        self._align = align
+        self.setFont(ui_font(px, weight))
+        self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed)
+
+    def setText(self, text):
+        self._text = text
+        self.updateGeometry()
+        self.update()
+
+    def sizeHint(self):
+        r = QFontMetrics(self.font()).boundingRect(QRect(0, 0, 10000, 10000), 0, self._text)
+        return QSize(r.width() + S(8), r.height() + S(8))
