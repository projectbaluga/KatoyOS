[Unit]
Description=KaraOkePi Standalone Wi-Fi Access Point (hostapd)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# Gate execution so HOTSPOT_MODE=fallback does not restart-loop in journal
ExecCondition=/usr/bin/katoy-ap-template check-mode
ExecStartPre=/usr/bin/katoy-ap-template setup
ExecStart=/usr/sbin/hostapd /etc/katoyos/hostapd.conf
ExecStartPost=/usr/bin/katoy-ap-template nat
Restart=always
RestartSec=3s
RestartPreventExitStatus=10

[Install]
WantedBy=multi-user.target
