#!/bin/sh
# dpkg pre-invoke hook: records WHO started dpkg (parent process chain) so a stray
# "Package configuration" screen can be traced afterwards. The log lands on the FAT boot
# partition, so it can be read from a PC: katoy-apt-trace.log
# Never fails and never prints, so it cannot break or slow a package operation.
LOG=/boot/firmware/katoy-apt-trace.log
[ -d /boot/firmware ] && [ -w /boot/firmware ] || LOG=/var/log/katoy-apt-trace.log
{
	echo "=== $(date '+%F %T')  uptime $(cut -d' ' -f1 /proc/uptime)s  frontend=${DEBIAN_FRONTEND:-unset}"
	pid=$PPID
	n=0
	while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$n" -lt 8 ]; do
		ps -o pid=,user=,args= -p "$pid" 2>/dev/null
		pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
		n=$((n + 1))
	done
} >>"$LOG" 2>/dev/null
if [ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 65536 ]; then
	tail -c 32768 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
fi
exit 0
