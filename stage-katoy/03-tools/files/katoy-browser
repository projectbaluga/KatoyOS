#!/usr/bin/env python3
"""Simple web browser for KatoyOS with search fallback and basic internet browsing."""
import os
import shutil
import sys
import urllib.parse
from pathlib import Path

try:
    from PyQt6.QtCore import QSize, QUrl
    from PyQt6.QtGui import QIcon
    from PyQt6.QtWidgets import QApplication, QHBoxLayout, QLineEdit, QMainWindow, QToolButton, QVBoxLayout, QWidget
    from PyQt6.QtWebEngineWidgets import QWebEngineView
except ImportError as exc:  # pragma: no cover - runtime dependency issue
    # Launched from the menu there is no terminal, so an error message would be
    # invisible. Hand over to Falkon instead of failing silently.
    fallback = shutil.which("falkon")
    if fallback:
        os.execv(fallback, [fallback, *sys.argv[1:]])
    raise SystemExit(
        "Katoy Browser needs python3-pyqt6.qtwebengine "
        "(sudo apt install python3-pyqt6.qtwebengine)."
    ) from exc


STYLE = Path("/usr/share/katoyos/win11/katoy-win11.qss")
HOME = "https://duckduckgo.com/"


def tool_button(icon_name, tip):
    btn = QToolButton()
    btn.setIcon(QIcon.fromTheme(icon_name))
    btn.setIconSize(QSize(20, 20))
    btn.setToolTip(tip)
    btn.setAutoRaise(True)
    return btn


class BrowserWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Katoy Browser")
        self.resize(1200, 800)

        self.setWindowIcon(QIcon.fromTheme("web-browser"))
        self.view = QWebEngineView()

        self.back_btn = tool_button("go-previous", "Back")
        self.forward_btn = tool_button("go-next", "Forward")
        self.reload_btn = tool_button("view-refresh", "Reload")
        self.home_btn = tool_button("go-home", "Home")
        self.url_bar = QLineEdit()
        self.url_bar.setPlaceholderText("Search or enter address")
        self.url_bar.returnPressed.connect(self.load_from_bar)

        self.back_btn.clicked.connect(self.view.back)
        self.forward_btn.clicked.connect(self.view.forward)
        self.reload_btn.clicked.connect(self.view.reload)
        self.home_btn.clicked.connect(lambda: self.load(HOME))

        nav = QHBoxLayout()
        nav.setContentsMargins(8, 6, 8, 6)
        nav.setSpacing(4)
        for btn in (self.back_btn, self.forward_btn, self.reload_btn, self.home_btn):
            nav.addWidget(btn)
        nav.addWidget(self.url_bar, 1)

        central = QWidget()
        layout = QVBoxLayout(central)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        layout.addLayout(nav)
        layout.addWidget(self.view)
        self.setCentralWidget(central)

        self.view.urlChanged.connect(self.update_url_bar)
        self.load(HOME)

    def normalize_url(self, text):
        value = text.strip()
        if not value:
            return None

        if "://" in value:
            return value

        if value.startswith("localhost") or value.startswith("127.0.0.1"):
            return "https://" + value

        if "." in value or value.startswith("/"):
            return "https://" + value

        return "https://duckduckgo.com/?q=" + urllib.parse.quote(value)

    def load_from_bar(self):
        self.load(self.url_bar.text())

    def load(self, value):
        url = self.normalize_url(value)
        if not url:
            return
        self.view.setUrl(QUrl(url))
        self.url_bar.setText(url)

    def update_url_bar(self, url):
        self.url_bar.setText(url.toString())


if __name__ == "__main__":
    app = QApplication(sys.argv)
    if STYLE.exists():
        app.setStyleSheet(STYLE.read_text())
    window = BrowserWindow()
    window.show()
    sys.exit(app.exec())
