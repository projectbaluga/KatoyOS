[Unit]
Description=Expand KATOYDATA FAT32 Partition to Fill the SD Card
DefaultDependencies=no
After=local-fs.target
Before=katoy-karaoke.service
ConditionPathExists=!/var/lib/katoyos/katoy-data-expanded

[Service]
Type=oneshot
ExecStart=/usr/bin/katoy-expand-data
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
