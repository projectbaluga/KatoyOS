def load_config():
    cfg = {
        "SONGS_DIR": "auto",
        "SOUNDFONT": "",
        "BACKGROUND": "",
        "AUDIO_DRIVER": "pulseaudio",
        "FULLSCREEN": "1",
        "KIOSK": "0",
    }
    if CONFIG_FILE.exists():
        try:
            for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
        except Exception as e:
            print(f"Error reading {CONFIG_FILE}: {e}")
    return cfg


def detect_usb_songs_dir():
    mount_roots = [Path("/media/katoy"), Path("/media"), Path("/run/media/katoy"), Path("/mnt")]
    candidate_subdirs = ["songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR"]

    for root in mount_roots:
        if not root.exists():
            continue
        for drive in root.iterdir():
            if drive.is_dir() and drive.name not in ("cdrom", "floppy"):
                # Check candidate subdirectories
                for sub in candidate_subdirs:
                    s_path = drive / sub
                    if s_path.is_dir():
                        return s_path
                # Check direct midi/kar files in drive root or any subfolder
                try:
                    for f in drive.glob("*"):
                        if f.is_file() and f.suffix.lower() in (".mid", ".kar"):
                            return drive
                        elif f.is_dir() and not f.name.startswith("."):
                            for sf in f.glob("*"):
                                if sf.is_file() and sf.suffix.lower() in (".mid", ".kar"):
                                    return drive
                except Exception:
                    pass
    return None


def find_soundfont(configured_path, usb_dir):
    if configured_path and Path(configured_path).exists():
        return Path(configured_path)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        try:
            sf_files = list(usb_root.rglob("*.sf2"))
            if sf_files:
                return sf_files[0]
        except Exception:
            pass

    for sys_sf in SYSTEM_SOUNDFONTS:
        if sys_sf.exists():
            return sys_sf

    return None


def find_backgrounds(configured_path, usb_dir):
    bg_list = []
    if configured_path:
        p = Path(configured_path)
        if p.is_file() and p.suffix.lower() in (".png", ".jpg", ".jpeg"):
            return [p]
        elif p.is_dir():
            bg_list = [f for f in p.iterdir() if f.suffix.lower() in (".png", ".jpg", ".jpeg")]
            if bg_list:
                return sorted(bg_list)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        for cand in [usb_root / "backgrounds", usb_root / "images", usb_root / "wallpapers"]:
            if cand.is_dir():
                imgs = [f for f in cand.iterdir() if f.suffix.lower() in (".png", ".jpg", ".jpeg")]
                if imgs:
                    return sorted(imgs)

    if DEFAULT_WALLPAPER.exists():
        return [DEFAULT_WALLPAPER]
    return []


def parse_filename_metadata(filepath, code_num):
    stem = filepath.stem
    code_str = f"{code_num:05d}"
    title = stem
    artist = "Unknown Artist"

    m = re.match(r"^(\d+)\s*[-_]\s*(.+)$", stem)
    if m:
        c_code, rest = m.group(1), m.group(2)
        code_str = c_code.zfill(5)
        if " - " in rest:
            parts = rest.split(" - ", 1)
            artist, title = parts[0].strip(), parts[1].strip()
        else:
            title = rest.strip()
    elif " - " in stem:
        parts = stem.split(" - ", 1)
        artist, title = parts[0].strip(), parts[1].strip()

    return code_str, title, artist


def extract_midi_lyrics_and_duration(filepath):
    try:
        mid = mido.MidiFile(filepath)
    except Exception as e:
        return [], 0.0, Path(filepath).stem, ""

    ticks_per_beat = mid.ticks_per_beat or 480

    tempo_changes = []
    max_ticks = 0
    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type == 'set_tempo':
                tempo_changes.append((abs_tick, msg.tempo))
        if abs_tick > max_ticks:
            max_ticks = abs_tick

    tempo_changes.sort(key=lambda x: x[0])
    if not tempo_changes or tempo_changes[0][0] > 0:
        tempo_changes.insert(0, (0, 500000))

    def tick_to_sec(target_tick):
        sec = 0.0
        last_tick = 0
        last_tempo = 500000
        for t_tick, t_tempo in tempo_changes:
            if t_tick >= target_tick:
                break
            sec += ((t_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
            last_tick = t_tick
            last_tempo = t_tempo
        sec += ((target_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
        return sec

    total_duration = tick_to_sec(max_ticks)

    raw_syllables = []
    meta_title = ""
    meta_artist = ""

    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type in ('lyrics', 'text'):
                txt = msg.text
                if not txt:
                    continue
                if txt.startswith('@T'):
                    t_val = txt[2:].strip()
                    if not meta_title:
                        meta_title = t_val
                    elif not meta_artist:
                        meta_artist = t_val
                elif txt.startswith('@'):
                    continue
                else:
                    sec = tick_to_sec(abs_tick)
                    raw_syllables.append((sec, txt))

    raw_syllables.sort(key=lambda x: x[0])

    lines = []
    cur_syls = []

    for sec, txt in raw_syllables:
        is_break = False
        clean_txt = txt
        if txt.startswith('/') or txt.startswith('\\'):
            is_break = True
            clean_txt = txt[1:]
        elif '\n' in txt or '\r' in txt:
            is_break = True
            clean_txt = txt.replace('\n', '').replace('\r', '')

        if is_break and cur_syls:
            line_str = "".join(s['text'] for s in cur_syls)
            lines.append({'text': line_str, 'syllables': cur_syls, 'start_sec': cur_syls[0]['sec']})
            cur_syls = []

        if clean_txt:
            cur_syls.append({'sec': sec, 'text': clean_txt})

    if cur_syls:
        line_str = "".join(s['text'] for s in cur_syls)
        lines.append({'text': line_str, 'syllables': cur_syls, 'start_sec': cur_syls[0]['sec']})

    return lines, total_duration, meta_title, meta_artist


class SongDatabase:
    def __init__(self, db_path):
        self.db_path = db_path
        self.conn = sqlite3.connect(db_path)
        self.create_tables()

    def create_tables(self):
        with self.conn:
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS songs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    code TEXT,
                    title TEXT,
                    artist TEXT,
                    filepath TEXT UNIQUE,
                    mtime REAL
                )
            """)
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_code ON songs(code)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_title ON songs(title)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_artist ON songs(artist)")

    def index_songs(self, songs_dir, force=False):
        songs_dir = Path(songs_dir)
        if not songs_dir.exists():
            return 0

        audio_files = []
        for root, _, files in os.walk(songs_dir):
            for f in files:
                if f.lower().endswith((".mid", ".kar")):
                    audio_files.append(Path(root) / f)

        audio_files.sort()

        if not force:
            cur = self.conn.cursor()
            cur.execute("SELECT COUNT(*), MAX(mtime) FROM songs")
            count, max_mtime = cur.fetchone()
            if count == len(audio_files) and count > 0:
                return count

        with self.conn:
            self.conn.execute("DELETE FROM songs")
            items = []
            for idx, fp in enumerate(audio_files, 1):
                try:
                    mtime = fp.stat().st_mtime
                except Exception:
                    mtime = 0.0
                code, title, artist = parse_filename_metadata(fp, idx)
                items.append((code, title, artist, str(fp), mtime))

            self.conn.executemany("""
                INSERT OR REPLACE INTO songs (code, title, artist, filepath, mtime)
                VALUES (?, ?, ?, ?, ?)
            """, items)

        return len(audio_files)

    def search(self, query=""):
        cur = self.conn.cursor()
        if not query.strip():
            cur.execute("SELECT code, title, artist, filepath FROM songs ORDER BY code ASC LIMIT 1000")
        else:
            q = f"%{query.strip()}%"
            cur.execute("""
                SELECT code, title, artist, filepath FROM songs
                WHERE code LIKE ? OR title LIKE ? OR artist LIKE ? OR filepath LIKE ?
                ORDER BY code ASC LIMIT 1000
            """, (q, q, q, q))
        return cur.fetchall()

    def get_by_code(self, code_str):
        cur = self.conn.cursor()
        c = code_str.zfill(5)
        cur.execute("SELECT code, title, artist, filepath FROM songs WHERE code = ? LIMIT 1", (c,))
        return cur.fetchone()

    def close(self):
        self.conn.close()


