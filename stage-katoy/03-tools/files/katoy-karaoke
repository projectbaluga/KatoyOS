class LyricLineWidget(QWidget):
    """One lyric line with a karaoke 'wipe' fill and dark outline.

    The outlined text is rendered ONCE per line into two pixmaps (white / sung
    gradient); each animation frame only blits them, so even 20 fps costs almost
    nothing on a Pi 3B. Font size auto-shrinks so a line never overflows the screen.
    """

    def __init__(self, px, mode="current", parent=None):
        super().__init__(parent)
        self.base_px = px
        self.mode = mode  # "current" (wipe) or "dim"
        self._segs = []   # (text, start_sec, end_sec)
        self._edges = []
        self._wipe = 0.0
        self._pix_base = None
        self._pix_sung = None
        self._sung_color = QColor("#4f9dff")
        self._dirty = True
        h = S(px) * 1.55
        self.setFixedHeight(int(h))
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    # public API ---------------------------------------------------------------
    def set_text(self, text):
        self.set_syllables([(text, 0.0, 0.0)] if text else [])

    def set_syllables(self, segs):
        self._segs = list(segs)
        self._wipe = 0.0
        self._dirty = True
        self.update()

    def set_mode(self, mode):
        """Switch a row between active/completed wipe rendering and dim preview."""
        if mode not in ("current", "dim") or self.mode == mode:
            return
        self.mode = mode
        self._dirty = True
        self.update()

    def set_shared_font_px(self, px):
        """Use one common rendered font size for both visible lyric rows."""
        px = max(14, int(px))
        if getattr(self, "_shared_font_px", None) == px:
            return
        self._shared_font_px = px
        self._dirty = True
        self.update()

    def set_sung_color(self, color):
        """Set the singer-specific color used for the sung portion of this line."""
        self._sung_color = QColor(color)
        self._dirty = True
        self.update()

    def set_elapsed(self, t):
        if self.mode != "current":
            return
        if self._dirty and self.width() > 20:
            self._rebuild()
        if not self._edges:
            return
        wipe = self._edges[0][0]
        for (x0, x1), (_, st, en) in zip(self._edges, self._segs):
            if t >= en:
                wipe = x1
            elif t >= st:
                wipe = x0 + (x1 - x0) * ((t - st) / max(0.05, en - st))
                break
            else:
                break
        if abs(wipe - self._wipe) >= 1.0:
            self._wipe = wipe
            self.update()

    def _reset_wipe(self):
        self._wipe = 0.0

    # internals ----------------------------------------------------------------
    def resizeEvent(self, ev):
        self._dirty = True
        super().resizeEvent(ev)

    def _rebuild(self):
        self._dirty = False
        self._pix_base = self._pix_sung = None
        self._edges = []
        w, h = self.width(), self.height()
        if not self._segs or w < 20:
            return
        full = "".join(t for t, _, _ in self._segs)
        px = min(S(self.base_px), getattr(self, "_shared_font_px", S(self.base_px)))
        min_px = max(14, int(px * 0.25))
        avail = w - S(60)
        while True:
            font = ui_font(1, QFont.Weight.ExtraBold if self.mode == "current" else QFont.Weight.Bold)
            font.setPixelSize(px)
            fm = QFontMetricsF(font)
            total = fm.horizontalAdvance(full)
            if total <= avail or px <= min_px:
                break
            px -= 2
        x = (w - total) / 2.0
        base = (h + fm.ascent() - fm.descent()) / 2.0
        path = QPainterPath()
        for text, _, _ in self._segs:
            sw = fm.horizontalAdvance(text)
            path.addText(QPointF(x, base), font, text)
            self._edges.append((x, x + sw))
            x += sw

        outline_w = max(3.0, px * 0.12) if self.mode == "current" else max(2.0, px * 0.07)
        pen = QPen(QColor(8, 4, 24, 235), outline_w, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap, Qt.PenJoinStyle.RoundJoin)

        def render(brush):
            pm = QPixmap(w, h)
            pm.fill(Qt.GlobalColor.transparent)
            pp = QPainter(pm)
            pp.setRenderHint(QPainter.RenderHint.Antialiasing)
            pp.strokePath(path, pen)
            pp.fillPath(path, brush)
            pp.end()
            return pm

        if self.mode == "current":
            self._pix_base = render(QBrush(QColor(255, 255, 255)))
            self._pix_sung = render(QBrush(self._sung_color))
        else:
            self._pix_base = render(QBrush(QColor(220, 225, 240, 200)))

    def paintEvent(self, ev):
        if self._dirty:
            self._rebuild()
        if not self._pix_base:
            return
        p = QPainter(self)
        p.drawPixmap(0, 0, self._pix_base)
        if self._pix_sung is not None and self._wipe > 0:
            wx = int(min(self.width(), self._wipe))
            if wx > 0:
                p.drawPixmap(0, 0, self._pix_sung, 0, 0, wx, self.height())


class SongRowDelegate(QStyledItemDelegate):
    """Paints the 3-column song table as rounded 'cards' with a gradient selection bar."""

    RAD = 18

    def sizeHint(self, option, index):
        return QSize(option.rect.width(), S(66))

    def _row_path(self, rect, col, last):
        rad = S(self.RAD)
        rr = QRectF(rect)
        if col == 0:
            rr.setRight(rr.right() + rad * 2)
        if col == last:
            rr.setLeft(rr.left() - rad * 2)
        if 0 < col < last:
            rr.adjust(-rad * 2, 0, rad * 2, 0)
        path = QPainterPath()
        path.addRoundedRect(rr, rad, rad)
        return path

    def paint(self, painter, option, index):
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setRenderHint(QPainter.RenderHint.TextAntialiasing)
        col = index.column()
        last = index.model().columnCount() - 1
        rect = option.rect.adjusted(0, S(4), 0, -S(4))
        selected = bool(option.state & QStyle.StateFlag.State_Selected)
        hover = bool(option.state & QStyle.StateFlag.State_MouseOver)

        painter.setClipRect(QRectF(rect))
        path = self._row_path(rect, col, last)
        if selected:
            vw = option.widget.viewport().width() if option.widget else rect.right()
            g = QLinearGradient(0, 0, vw, 0)
            g.setColorAt(0, COL_PINK)
            g.setColorAt(1, COL_VIOLET)
            painter.fillPath(path, QBrush(g))
        else:
            painter.fillPath(path, QColor(255, 255, 255, 20 if hover else 10))

        text = str(index.data() or "")
        pad = S(22)
        tr = rect.adjusted(pad, 0, -pad, 0)
        if col == 0:
            painter.setFont(ui_font(23, QFont.Weight.ExtraBold))
            painter.setPen(QColor("#ffffff") if selected else COL_GOLD)
        elif col == 1:
            painter.setFont(ui_font(24, QFont.Weight.Bold))
            painter.setPen(QColor("#ffffff"))
        else:
            painter.setFont(ui_font(20, QFont.Weight.Medium))
            painter.setPen(QColor(255, 255, 255, 225) if selected else COL_MUTED)
        el = QFontMetrics(painter.font()).elidedText(text, Qt.TextElideMode.ElideRight, tr.width())
        painter.drawText(tr, int(Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft), el)
        painter.restore()


class QueueRowDelegate(QStyledItemDelegate):
    """Reservation queue rows: numbered gradient badge + title / artist."""

    def sizeHint(self, option, index):
        return QSize(option.rect.width(), S(82))

    def paint(self, painter, option, index):
        data = index.data(Qt.ItemDataRole.UserRole) or (0, "", "", "", "")
        n = data[0]
        code = data[1]
        title = data[2]
        artist = data[3]
        singer = data[4] if len(data) > 4 else ""
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setRenderHint(QPainter.RenderHint.TextAntialiasing)
        r = option.rect.adjusted(S(4), S(5), -S(4), -S(5))
        selected = bool(option.state & QStyle.StateFlag.State_Selected)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QColor(255, 255, 255, 26 if selected else 12))
        painter.drawRoundedRect(QRectF(r), S(18), S(18))

        d = S(46)
        bx, by = r.left() + S(14), r.top() + (r.height() - d) // 2
        g = QLinearGradient(bx, by, bx + d, by + d)
        g.setColorAt(0, COL_PINK if n > 1 else COL_MINT)
        g.setColorAt(1, COL_VIOLET if n > 1 else COL_CYAN)
        painter.setBrush(QBrush(g))
        painter.drawEllipse(QRectF(bx, by, d, d))
        painter.setPen(QColor("#ffffff") if n > 1 else QColor("#052e22"))
        painter.setFont(ui_font(22, QFont.Weight.ExtraBold))
        painter.drawText(QRectF(bx, by, d, d), int(Qt.AlignmentFlag.AlignCenter), str(n))

        tx = bx + d + S(16)
        tw = r.right() - tx - S(12)
        painter.setFont(ui_font(21, QFont.Weight.Bold))
        painter.setPen(QColor("#ffffff"))
        el = QFontMetrics(painter.font()).elidedText(title, Qt.TextElideMode.ElideRight, tw)
        painter.drawText(QRectF(tx, r.top() + S(8), tw, r.height() / 2), int(Qt.AlignmentFlag.AlignVCenter), el)
        painter.setFont(ui_font(17, QFont.Weight.Medium))
        painter.setPen(COL_MUTED)
        sub = f"{code}  ·  {artist}" + (f"  ·  🎤 {singer}" if singer else "")
        el = QFontMetrics(painter.font()).elidedText(sub, Qt.TextElideMode.ElideRight, tw)
        painter.drawText(QRectF(tx, r.top() + r.height() / 2 - S(2), tw, r.height() / 2 - S(6)), int(Qt.AlignmentFlag.AlignVCenter), el)
        painter.restore()


