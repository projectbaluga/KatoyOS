def apply_theme(app, screen_height=None):
    """Install palette, base font and stylesheet. Call once before building any widget."""
    h = screen_height
    if h is None:
        scr = app.primaryScreen()
        h = scr.size().height() if scr else 1080
    UI_SCALE[0] = max(0.6, min(1.5, h / 1080.0))
    app.setFont(ui_font(18))
    pal = app.palette()
    pal.setColor(QPalette.ColorRole.Window, COL_BG_TOP)
    pal.setColor(QPalette.ColorRole.WindowText, COL_TEXT)
    pal.setColor(QPalette.ColorRole.Text, COL_TEXT)
    pal.setColor(QPalette.ColorRole.Base, QColor(20, 12, 50))
    pal.setColor(QPalette.ColorRole.PlaceholderText, QColor(169, 161, 214, 150))
    app.setPalette(pal)
    app.setStyleSheet(build_qss())


