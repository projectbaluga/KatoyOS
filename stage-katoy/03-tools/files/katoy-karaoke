class PersistentFluidSynth:
    """CTypes wrapper around libfluidsynth.so to keep SoundFonts loaded in RAM."""

    FLUID_PLAYER_READY = 0
    FLUID_PLAYER_PLAYING = 1
    FLUID_PLAYER_STOPPING = 2
    FLUID_PLAYER_DONE = 3

    def __init__(self, soundfont_path, audio_driver="pulseaudio"):
        self.soundfont_path = Path(soundfont_path)
        self.audio_driver = audio_driver
        self.lib = None
        self.settings = None
        self.synth = None
        self.adriver = None
        self.player = None
        self.sfont_id = -1
        self.is_initialized = False
        self.saved_tick = 0
        self.is_paused = False

        self._init_library()

    def _init_library(self):
        lib_path = ctypes.util.find_library("fluidsynth") or "libfluidsynth.so.3"
        try:
            self.lib = ctypes.CDLL(lib_path)
        except Exception as e:
            print(f"Failed to load libfluidsynth ({lib_path}): {e}")
            return

        try:
            self.lib.new_fluid_settings.restype = ctypes.c_void_p

            self.lib.fluid_settings_setstr.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_char_p]
            self.lib.fluid_settings_setnum.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_double]
            self.lib.fluid_settings_setint.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]

            self.lib.new_fluid_synth.argtypes = [ctypes.c_void_p]
            self.lib.new_fluid_synth.restype = ctypes.c_void_p

            self.lib.new_fluid_audio_driver.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
            self.lib.new_fluid_audio_driver.restype = ctypes.c_void_p

            self.lib.new_fluid_player.argtypes = [ctypes.c_void_p]
            self.lib.new_fluid_player.restype = ctypes.c_void_p

            self.lib.fluid_synth_sfload.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
            self.lib.fluid_synth_sfload.restype = ctypes.c_int

            self.lib.fluid_player_add.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
            self.lib.fluid_player_add.restype = ctypes.c_int

            self.lib.fluid_player_play.argtypes = [ctypes.c_void_p]
            self.lib.fluid_player_play.restype = ctypes.c_int

            self.lib.fluid_player_stop.argtypes = [ctypes.c_void_p]
            self.lib.fluid_player_stop.restype = ctypes.c_int

            self.lib.fluid_player_get_status.argtypes = [ctypes.c_void_p]
            self.lib.fluid_player_get_status.restype = ctypes.c_int

            self.lib.fluid_player_get_current_tick.argtypes = [ctypes.c_void_p]
            self.lib.fluid_player_get_current_tick.restype = ctypes.c_int

            self.lib.fluid_player_get_total_ticks.argtypes = [ctypes.c_void_p]
            self.lib.fluid_player_get_total_ticks.restype = ctypes.c_int

            if hasattr(self.lib, 'fluid_player_seek'):
                self.lib.fluid_player_seek.argtypes = [ctypes.c_void_p, ctypes.c_int]
                self.lib.fluid_player_seek.restype = ctypes.c_int

            self.lib.delete_fluid_player.argtypes = [ctypes.c_void_p]
            self.lib.delete_fluid_audio_driver.argtypes = [ctypes.c_void_p]
            self.lib.delete_fluid_synth.argtypes = [ctypes.c_void_p]
            self.lib.delete_fluid_settings.argtypes = [ctypes.c_void_p]

            if hasattr(self.lib, 'fluid_synth_all_notes_off'):
                self.lib.fluid_synth_all_notes_off.argtypes = [ctypes.c_void_p, ctypes.c_int]

            self.settings = self.lib.new_fluid_settings()
            if not self.settings:
                return

            # Pi 3B Hardware Tuning
            drv_b = self.audio_driver.encode('utf-8')
            self.lib.fluid_settings_setstr(self.settings, b"audio.driver", drv_b)
            self.lib.fluid_settings_setnum(self.settings, b"synth.sample-rate", ctypes.c_double(44100.0))
            self.lib.fluid_settings_setint(self.settings, b"synth.polyphony", ctypes.c_int(64))
            self.lib.fluid_settings_setint(self.settings, b"synth.reverb.active", ctypes.c_int(0))
            self.lib.fluid_settings_setint(self.settings, b"synth.chorus.active", ctypes.c_int(0))

            self.synth = self.lib.new_fluid_synth(self.settings)
            if not self.synth:
                return

            self.adriver = self.lib.new_fluid_audio_driver(self.settings, self.synth)
            if not self.adriver:
                return

            if self.soundfont_path.exists():
                sf_b = str(self.soundfont_path).encode('utf-8')
                self.sfont_id = self.lib.fluid_synth_sfload(self.synth, sf_b, 1)

            self.is_initialized = True
        except Exception as e:
            print(f"PersistentFluidSynth init error: {e}")

    def load_song(self, midi_path):
        if not self.is_initialized:
            return False

        self.stop()
        if self.player:
            try:
                self.lib.delete_fluid_player(self.player)
            except Exception:
                pass
            self.player = None

        try:
            self.player = self.lib.new_fluid_player(self.synth)
            if not self.player:
                return False
            midi_b = str(midi_path).encode('utf-8')
            res = self.lib.fluid_player_add(self.player, midi_b)
            return res == 0
        except Exception as e:
            print(f"Error loading song into player: {e}")
            return False

    def play(self):
        if self.player:
            self.is_paused = False
            return self.lib.fluid_player_play(self.player) == 0
        return False

    def pause(self):
        if self.player and not self.is_paused:
            self.saved_tick = self.get_current_tick()
            self.lib.fluid_player_stop(self.player)
            if hasattr(self.lib, 'fluid_synth_all_notes_off') and self.synth:
                for ch in range(16):
                    self.lib.fluid_synth_all_notes_off(self.synth, ch)
            self.is_paused = True

    def resume(self):
        if self.player and self.is_paused:
            res = self.lib.fluid_player_play(self.player)
            if hasattr(self.lib, 'fluid_player_seek'):
                self.lib.fluid_player_seek(self.player, self.saved_tick)
            self.is_paused = False
            return res == 0
        return False

    def stop(self):
        self.is_paused = False
        if self.player:
            try:
                self.lib.fluid_player_stop(self.player)
                if hasattr(self.lib, 'fluid_synth_all_notes_off') and self.synth:
                    for ch in range(16):
                        self.lib.fluid_synth_all_notes_off(self.synth, ch)
            except Exception:
                pass

    def get_status(self):
        if self.player:
            return self.lib.fluid_player_get_status(self.player)
        return self.FLUID_PLAYER_DONE

    def get_current_tick(self):
        if self.player:
            return self.lib.fluid_player_get_current_tick(self.player)
        return 0

    def get_total_ticks(self):
        if self.player:
            return self.lib.fluid_player_get_total_ticks(self.player)
        return 0

    def cleanup(self):
        self.stop()
        if self.player:
            self.lib.delete_fluid_player(self.player)
            self.player = None
        if self.adriver:
            self.lib.delete_fluid_audio_driver(self.adriver)
            self.adriver = None
        if self.synth:
            self.lib.delete_fluid_synth(self.synth)
            self.synth = None
        if self.settings:
            self.lib.delete_fluid_settings(self.settings)
            self.settings = None
        self.is_initialized = False

