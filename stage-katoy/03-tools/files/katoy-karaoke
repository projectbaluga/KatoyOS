def get_local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(('10.255.255.255', 1))
        IP = s.getsockname()[0]
    except Exception:
        IP = '127.0.0.1'
    finally:
        s.close()
    return IP


def parse_systemd_analyze_output(output_str):
    """Pure helper function parsing systemd-analyze output."""
    if not output_str:
        return None
    # Example format: Startup finished in 4.120s (kernel) + 17.340s (userspace) = 21.460s
    m = re.search(r"Startup finished in\s+(.*?)\s*=\s*([\d\.]+[s|ms]+)", output_str)
    if m:
        breakdown = m.group(1).strip()
        total = m.group(2).strip()
        return f"Boot time: {total} ({breakdown}) | target ~25s"
    return None


def get_systemd_boot_time():
    """Reads systemd-analyze output to retrieve real boot duration."""
    if shutil.which("systemd-analyze"):
        try:
            res = subprocess.run(["systemd-analyze"], capture_output=True, text=True)
            parsed = parse_systemd_analyze_output(res.stdout)
            if parsed:
                return parsed
        except Exception:
            pass
    return "Boot time: unmeasured (target ~25s)"


def parse_nmcli_wifi_list(output_str):
    """Pure helper function parsing nmcli wifi list output into structured SSIDs."""
    if not output_str:
        return []
    ssids = []
    seen = set()
    for line in output_str.strip().splitlines():
        parts = line.split(":")
        if parts and parts[0].strip():
            ssid = parts[0].strip()
            if ssid not in seen and ssid != "--":
                seen.add(ssid)
                ssids.append(ssid)
    return ssids


def parse_nmcli_general_state(output_str):
    """Pure helper function parsing nmcli general state output."""
    if not output_str:
        return "unknown"
    clean = output_str.strip().lower()
    if "connected (local only)" in clean or "connected (site only)" in clean:
        return "limited"
    elif "disconnected" in clean or "asleep" in clean:
        return "disconnected"
    elif "connected" in clean:
        return "connected"
    return clean


def check_and_trigger_wifi_hotspot(config):
    """Checks NetworkManager connection state and launches AP setup hotspot if disconnected."""
    if not shutil.which("nmcli"):
        return False, ""
    try:
        res = subprocess.run(["nmcli", "-t", "-g", "STATE", "general"], capture_output=True, text=True)
        state = parse_nmcli_general_state(res.stdout)
        if state != "connected":
            ssid = config.get("HOTSPOT_SSID", "KatoyOS-Karaoke")
            password = config.get("HOTSPOT_PASSWORD", "katoyos123")
            ifname = config.get("HOTSPOT_IFNAME", "wlan0")
            subprocess.run(
                ["nmcli", "device", "wifi", "hotspot", "ifname", ifname, "ssid", ssid, "password", password],
                stderr=subprocess.DEVNULL
            )
            return True, ssid
    except Exception as e:
        print(f"Hotspot setup error: {e}")
    return False, ""


def generate_qr_matrix(text):
    try:
        import qrcode
        qr = qrcode.QRCode(version=1, box_size=1, border=0)
        qr.add_data(text)
        qr.make(fit=True)
        return qr.get_matrix()
    except Exception:
        size = 21
        matrix = [[False]*size for _ in range(size)]
        def add_finder(rx, ry):
            for r in range(7):
                for c in range(7):
                    if r in (0, 6) or c in (0, 6) or (2 <= r <= 4 and 2 <= c <= 4):
                        matrix[rx + r][ry + c] = True

        add_finder(0, 0)
        add_finder(0, size - 7)
        add_finder(size - 7, 0)

        for i in range(8, size - 8):
            if i % 2 == 0:
                matrix[6][i] = True
                matrix[i][6] = True

        h = hash(text) & 0xFFFFFFFF
        for r in range(size):
            for c in range(size):
                if not matrix[r][c] and not (r < 9 and c < 9) and not (r < 9 and c >= size - 8) and not (r >= size - 8 and c < 9):
                    if ((r * 7 + c * 13 + h) % 3) == 0:
                        matrix[r][c] = True

        return matrix


def create_qr_pixmap(text, scale=6):
    matrix = generate_qr_matrix(text)
    size = len(matrix)
    img_size = size * scale
    img = QImage(img_size, img_size, QImage.Format.Format_RGB32)
    img.fill(QColor(255, 255, 255))

    for r in range(size):
        for c in range(size):
            if matrix[r][c]:
                for dx in range(scale):
                    for dy in range(scale):
                        img.setPixelColor(c * scale + dx, r * scale + dy, QColor(0, 0, 0))

    return QPixmap.fromImage(img)


