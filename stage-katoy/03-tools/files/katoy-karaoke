    def stop_playback(self, resume_background=True):
        self.play_timer.stop()
        self.score_timer.stop()

        if self.persistent_synth:
            self.persistent_synth.stop()

        if self.fluid_proc:
            try:
                self.fluid_proc.terminate()
                self.fluid_proc.wait(timeout=1.0)
            except Exception:
                try:
                    self.fluid_proc.kill()
                except Exception:
                    pass
            self.fluid_proc = None

        self.is_playing = False
        self.is_paused = False
        self.current_song = None

        # Never leave the song video running on an idle/library screen.
        self.stop_background_video()
        if resume_background:
            self.bg_timer.start()
            self.update_background_image()
        else:
            self.bg_timer.stop()

        self.hide_score()
        self.controls_timer.stop()
        if hasattr(self, "controls_card") and self.controls_card:
            self.controls_card.show()

        if self.stack.currentWidget() == self.player_page:
            self.stack.setCurrentWidget(self.library_page)

    def update_playback_ui(self):
        if not self.is_playing:
            return

        using_persistent = (
            self.persistent_synth and
            self.persistent_synth.is_initialized and
            self.persistent_synth.player and
            not self.fluid_proc
        )

        if using_persistent:
            status = self.persistent_synth.get_status()
            if status == PersistentFluidSynth.FLUID_PLAYER_DONE and not self.is_paused:
                self.show_pinoy_score_banner()
                self.play_timer.stop()
                return
        elif self.fluid_proc and self.fluid_proc.poll() is not None and not self.is_paused:
            self.show_pinoy_score_banner()
            self.play_timer.stop()
            return

        if using_persistent:
            if self.is_paused:
                cur_tick = self.persistent_synth.saved_tick
            else:
                cur_tick = self.persistent_synth.get_current_tick()
            tot_ticks = self.persistent_synth.get_total_ticks()
            elapsed = calculate_elapsed_seconds(cur_tick, tot_ticks, self.song_duration)
        else:
            if self.is_paused:
                elapsed = self.playback_paused_at - self.playback_start_time
            else:
                elapsed = time.time() - self.playback_start_time

        elapsed = max(0.0, elapsed)
        dur = max(1.0, self.song_duration)

        m_el, s_el = divmod(int(elapsed), 60)
        m_du, s_du = divmod(int(dur), 60)
        self.time_lbl.setText(f"{m_el:02d}:{s_el:02d} / {m_du:02d}:{s_du:02d}")

        pct = int((elapsed / dur) * 100)
        self.progress_bar.setValue(min(100, pct))

        eff_elapsed = max(0.0, elapsed + getattr(self, "lyric_offset", 0.0))
        self.render_lyrics(eff_elapsed)

    def _segments_for_line(self, idx):
        line = self.lyrics_lines[idx]
        syls = line['syllables']
        nxt = self.lyrics_lines[idx + 1]['start_sec'] if idx + 1 < len(self.lyrics_lines) else None
        segs = []
        for i, syl in enumerate(syls):
            start = syl['sec']
            if i + 1 < len(syls):
                end = syls[i + 1]['sec']
            else:
                end = start + 1.0
                if nxt is not None:
                    end = min(end, max(start + 0.2, nxt))
            segs.append((syl['text'], start, max(end, start + 0.05)))
        return segs or [(line['text'], line['start_sec'], line['start_sec'] + 1.5)]

    def _lyric_rollover_time(self, idx):
        """Time to preview the line after the active line, shortly before it ends."""
        line = self.lyrics_lines[idx]
        syllables = line.get('syllables', [])
        if syllables:
            line_end = syllables[-1]['sec'] + 1.0
        else:
            line_end = line['start_sec'] + 2.0
        line_duration = max(0.5, line_end - line['start_sec'])
        lead_time = min(1.5, max(0.35, line_duration * 0.18))
        return max(line['start_sec'], line_end - lead_time)

    def _set_lyric_row(self, widget, idx, elapsed_sec, active=False, completed=False):
        if idx is None or idx < 0 or idx >= len(self.lyrics_lines):
            widget.set_mode("dim")
            widget.set_text("")
            return
        if active or completed:
            widget.set_mode("current")
            widget.set_syllables(self._segments_for_line(idx))
            widget.set_elapsed(elapsed_sec if active else 1e9)
        else:
            widget.set_mode("dim")
            widget.set_text(self.lyrics_lines[idx]['text'])

    def _fit_lyric_pair_font(self):
        """Choose one font size that fits both visible rows, keeping them identical."""
        widgets = (self.lyric_curr_lbl, self.lyric_next_lbl)
        texts = ["".join(part[0] for part in widget._segs) for widget in widgets]
        available = max(20, min(widget.width() for widget in widgets) - S(60))
        px = S(84)
        min_px = max(14, int(px * 0.25))
        while px > min_px:
            font = ui_font(1, QFont.Weight.ExtraBold)
            font.setPixelSize(px)
            metrics = QFontMetricsF(font)
            if all(metrics.horizontalAdvance(value) <= available for value in texts):
                break
            px -= 2
        for widget in widgets:
            widget.set_shared_font_px(px)

    def render_lyrics(self, elapsed_sec):
        """Render a rolling two-line window without advancing both rows together.

        Line 1 is active while line 2 waits below it. Once line 1 ends, line 1
        stays visible as completed while line 2 becomes active. Near the end of
        line 2, the upcoming line is previewed in row 1; row 2 keeps highlighting
        line 2. When the next line actually starts, it becomes active in row 1.
        """
        if not self.lyrics_lines:
            if self._lyric_idx != -3:
                self._lyric_idx = -3
                self._lyric_layout = None
                self.lyric_curr_lbl.set_text("♪   Instrumental   ♪")
                self.lyric_next_lbl.set_text("")
            return

        curr_idx = -1
        for idx, line in enumerate(self.lyrics_lines):
            if elapsed_sec >= line['start_sec']:
                curr_idx = idx
            else:
                break

        n = len(self.lyrics_lines)
        if curr_idx < 0:
            # Before the first vocal entry, show the first two lines as previews.
            top_idx, bottom_idx, active_slot = 0, (1 if n > 1 else None), None
        elif curr_idx == 0:
            top_idx, bottom_idx, active_slot = 0, (1 if n > 1 else None), "top"
        elif curr_idx % 2 == 0:
            # Odd-numbered song lines (index 0, 2, 4...) are sung on the upper row.
            top_idx, bottom_idx, active_slot = curr_idx, (curr_idx + 1 if curr_idx + 1 < n else None), "top"
        elif elapsed_sec < self._lyric_rollover_time(curr_idx):
            # Even-numbered song lines stay on the lower row; keep the previous
            # completed line above until the lower line is nearly finished.
            top_idx, bottom_idx, active_slot = curr_idx - 1, curr_idx, "bottom"
        else:
            # Near the end of a lower-row line, preview the following line above
            # while the current lower-row line keeps its highlighting.
            top_idx, bottom_idx, active_slot = (curr_idx + 1 if curr_idx + 1 < n else None), curr_idx, "bottom"

        layout = (top_idx, bottom_idx, active_slot)
        if layout != getattr(self, "_lyric_layout", None):
            self._lyric_layout = layout
            self._set_lyric_row(
                self.lyric_curr_lbl, top_idx, elapsed_sec,
                active=(active_slot == "top"),
                completed=(active_slot == "bottom" and top_idx == curr_idx - 1),
            )
            self._set_lyric_row(
                self.lyric_next_lbl, bottom_idx, elapsed_sec,
                active=(active_slot == "bottom"),
            )
            self._fit_lyric_pair_font()

        # Update the active wipe every playback tick; completed top rows remain fully sung.
        if active_slot == "top" and top_idx is not None:
            self.lyric_curr_lbl.set_elapsed(elapsed_sec)
        elif active_slot == "bottom" and bottom_idx is not None:
            self.lyric_next_lbl.set_elapsed(elapsed_sec)
            if top_idx == curr_idx - 1:
                self.lyric_curr_lbl.set_elapsed(1e9)

        self._lyric_idx = curr_idx

    def _is_video_file(self, path):
        return bool(path and path.suffix.lower() in VIDEO_EXTS)

    def start_background_video(self, video_path):
        """Play a background video inside the player page while a song is active."""
        if not self.is_playing or self.stack.currentWidget() is not self.player_page:
            return False
        if self.bg_video_proc and self.bg_video_proc.poll() is None:
            if self._current_bg_video == video_path:
                return True
            self.stop_background_video()

        if not shutil.which("mpv"):
            if not self._mpv_warned:
                print("Warning: mpv binary not found; falling back to image slideshow background.")
                self._mpv_warned = True
            return False

        if not video_path.exists():
            return False

        # Embed mpv into the dedicated native video child surface on the
        # player page. Never target self.winId(): that is the top-level window.
        if not hasattr(self, "bg_video_surface"):
            return False
        self.bg_video_surface.show()
        wid = str(int(self.bg_video_surface.winId()))
        cmd = [
            "mpv",
            "--no-config",
            "--no-audio",
            "--loop-file=inf",
            "--really-quiet",
            "--no-osc",
            "--no-input-default-bindings",
            "--no-border",
            "--no-ontop",
            "--fullscreen=no",
            "--force-window=no",
            "--hwdec=auto",
            "--vo=gpu",
            "--gpu-context=x11egl",
            f"--wid={wid}",
            str(video_path),
        ]
        try:
            proc = subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
            self.bg_video_proc = proc
            self._current_bg_video = video_path
            QTimer.singleShot(
                1200, lambda p=proc, v=video_path: self._verify_background_video(p, v)
            )
            return True
        except Exception as e:
            if not self._mpv_warned:
                print(f"Warning: Failed to launch embedded background video with mpv ({e}); falling back to images.")
                self._mpv_warned = True
            self.bg_video_proc = None
            self._current_bg_video = None
            if hasattr(self, "bg_video_surface"):
                self.bg_video_surface.hide()
            return False

    def _verify_background_video(self, proc, video_path):
        """Detect an mpv startup failure and restore a still-image background."""
        if self.bg_video_proc is not proc or proc.poll() is None:
            return

        self.bg_video_proc = None
        self._current_bg_video = None
        if hasattr(self, "bg_video_surface"):
            self.bg_video_surface.hide()
        if not self._mpv_warned:
            print(f"Warning: mpv exited while opening {video_path}; using a still background if available.")
            self._mpv_warned = True

        fallback = next(
            (p for p in self.backgrounds if p.suffix.lower() in IMAGE_EXTS and p.exists()),
            None,
        )
        if fallback:
            pix = QPixmap(str(fallback))
            if not pix.isNull():
                self._cover_src = pix
        self._cover_cache = None
        self.update()

    def stop_background_video(self):
        proc = self.bg_video_proc
        self.bg_video_proc = None
        self._current_bg_video = None
        if hasattr(self, "bg_video_surface"):
            self.bg_video_surface.hide()
        if proc and proc.poll() is None:
            try:
                proc.terminate()
                try:
                    proc.wait(timeout=1.5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=1.0)
            except Exception:
                pass

    def rotate_background(self):
        if len(self.backgrounds) == 1:
            curr_path = self.backgrounds[0]
            if self._is_video_file(curr_path) and (not self.bg_video_proc or self.bg_video_proc.poll() is not None):
                self.update_background_image()
            return

        if len(self.backgrounds) > 1:
            self.bg_index = (self.bg_index + 1) % len(self.backgrounds)
            self.update_background_image()

    def update_background_image(self):
        self._cover_cache = None
        self._cover_src = None
        if not self.backgrounds:
            self.stop_background_video()
            self.update()
            return

        path = self.backgrounds[self.bg_index % len(self.backgrounds)]
        if self._is_video_file(path):
            # Idle/library/settings pages are deliberately still-image only.
            # The selected video is started later, after the player page opens.
            fallback = next((p for p in self.backgrounds if p.suffix.lower() in IMAGE_EXTS and p.exists()), None)
            if fallback:
                pix = QPixmap(str(fallback))
                if not pix.isNull():
                    self._cover_src = pix
        else:
            self.stop_background_video()
            if path.exists():
                pix = QPixmap(str(path))
                if not pix.isNull():
                    self._cover_src = pix
        self.update()

    def on_escape_pressed(self):
        cur = self.stack.currentWidget()
        if cur is self.player_page:
            self.stop_playback()
        elif cur is self.settings_page:
            self.stack.setCurrentWidget(self.library_page)
        elif cur is self.library_page and not self.kiosk:
            self.close()  # appliance mode never quits: there is no desktop to fall back to

    def closeEvent(self, event):
        # Detach everything that can call back into this window while it is being torn down.
        app = QApplication.instance()
        if app:
            app.removeEventFilter(self)
        for tm in (self.poll_timer, self.play_timer, self.bg_timer, self.score_timer, self.controls_timer):
            tm.stop()
        if self.net_watcher:
            self.net_watcher.stop()
        if self.remote_server:
            self.remote_server.stop()
        self.stop_playback()
        self.stop_background_video()
        if self.db:
            self.db.close()
        event.accept()


def main():
    config = load_config()
    app = QApplication(sys.argv)
    app.setApplicationName("KaraOkePi")
    apply_theme(app)

    player = KaraokeApp(config)
    player.present()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()