def detect_usb_songs_dir():
    mount_roots = [Path("/media/katoy"), Path("/media"), Path("/run/media/katoy"), Path("/mnt")]
    candidate_subdirs = ["songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR"]

    for root in mount_roots:
        if not root.exists():
            continue
        for drive in root.iterdir():
            if drive.is_dir() and drive.name not in ("cdrom", "floppy"):
                for sub in candidate_subdirs:
                    s_path = drive / sub
                    if s_path.is_dir():
                        return s_path
                try:
                    for f in drive.glob("*"):
                        if f.is_file() and f.suffix.lower() in (".mid", ".kar"):
                            return drive
                        elif f.is_dir() and not f.name.startswith("."):
                            for sf in f.glob("*"):
                                if sf.is_file() and sf.suffix.lower() in (".mid", ".kar"):
                                    return drive
                except Exception:
                    pass
    return None


_SOUNDFONT_CACHE = {}


def find_soundfont(configured_path, usb_dir):
    if configured_path and Path(configured_path).exists():
        return Path(configured_path)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        cache_key = str(usb_root.resolve())
        if cache_key in _SOUNDFONT_CACHE:
            cached = _SOUNDFONT_CACHE[cache_key]
            if cached and cached.exists():
                return cached

        # Shallow search up to depth 2 to avoid blocking the UI poll loop on large drives
        sf_found = None
        try:
            for item in usb_root.iterdir():
                if item.is_file() and item.suffix.lower() == ".sf2":
                    sf_found = item
                    break
                elif item.is_dir() and not item.name.startswith("."):
                    for subitem in item.iterdir():
                        if subitem.is_file() and subitem.suffix.lower() == ".sf2":
                            sf_found = subitem
                            break
                    if sf_found:
                        break
        except Exception:
            pass

        _SOUNDFONT_CACHE[cache_key] = sf_found
        if sf_found:
            return sf_found

    for sys_sf in SYSTEM_SOUNDFONTS:
        if sys_sf.exists():
            return sys_sf

    return None


def find_backgrounds(configured_path, usb_dir):
