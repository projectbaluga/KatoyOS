    def on_remote_reserve_song(self, song_tuple):
        code = song_tuple[0]
        title = song_tuple[1]
        artist = song_tuple[2]
        filepath = song_tuple[3]
        singer = song_tuple[4] if len(song_tuple) > 4 else ""
        entry = (code, title, artist, filepath, singer)
        self.reservation_queue.append(entry)
        self.update_queue_ui()
        if hasattr(self, "status_lbl"):
            self.status_lbl.setText(f"Remote reserved: [{code}] {title}")
        self.toast.flash(f"Reserved from phone: {title}", 3000)
        # If nothing is currently playing, start playback automatically
        if not self.is_playing:
            self.play_next_reserved_song()

    def on_remote_play_song(self, song_tuple):
        code = song_tuple[0]
        title = song_tuple[1]
        artist = song_tuple[2]
        filepath = song_tuple[3]
        singer = song_tuple[4] if len(song_tuple) > 4 else ""
        self.start_playback(code, title, artist, filepath, singer=singer)

    def on_remote_remove_queue(self, idx):
        if 0 <= idx < len(self.reservation_queue):
            removed = self.reservation_queue.pop(idx)
            self.update_queue_ui()
            self.toast.flash(f"Removed: {removed[1]}", 2000)

