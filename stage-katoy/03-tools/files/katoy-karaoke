def detect_usb_songs_dir():
    mount_roots = [Path("/media/katoy"), Path("/media"), Path("/run/media/katoy"), Path("/mnt")]
    candidate_subdirs = ["songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR"]

    for root in mount_roots:
        if not root.exists():
            continue
        for drive in root.iterdir():
            if drive.is_dir() and drive.name not in ("cdrom", "floppy"):
                for sub in candidate_subdirs:
                    s_path = drive / sub
                    if s_path.is_dir():
                        return s_path
                try:
                    for f in drive.glob("*"):
                        if f.is_file() and f.suffix.lower() in (".mid", ".kar"):
                            return drive
                        elif f.is_dir() and not f.name.startswith("."):
                            for sf in f.glob("*"):
                                if sf.is_file() and sf.suffix.lower() in (".mid", ".kar"):
                                    return drive
                except Exception:
                    pass
    return None


_SOUNDFONT_CACHE = {}


def find_soundfont(configured_path, usb_dir):
    if configured_path and Path(configured_path).exists():
        return Path(configured_path)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        cache_key = str(usb_root.resolve())
        if cache_key in _SOUNDFONT_CACHE:
            cached = _SOUNDFONT_CACHE[cache_key]
            if cached and cached.exists():
                return cached

        # Shallow search up to depth 2 to avoid blocking the UI poll loop on large drives
        sf_found = None
        try:
            for item in usb_root.iterdir():
                if item.is_file() and item.suffix.lower() == ".sf2":
                    sf_found = item
                    break
                elif item.is_dir() and not item.name.startswith("."):
                    for subitem in item.iterdir():
                        if subitem.is_file() and subitem.suffix.lower() == ".sf2":
                            sf_found = subitem
                            break
                    if sf_found:
                        break
        except Exception:
            pass

        _SOUNDFONT_CACHE[cache_key] = sf_found
        if sf_found:
            return sf_found

    for sys_sf in SYSTEM_SOUNDFONTS:
        if sys_sf.exists():
            return sys_sf

    return None


VIDEO_EXTS = (".mp4", ".mkv", ".webm")
IMAGE_EXTS = (".png", ".jpg", ".jpeg")
ALL_BG_EXTS = VIDEO_EXTS + IMAGE_EXTS

# Recommended video specifications for Raspberry Pi 3B (1 GB RAM, VC4/fkms):
# - Resolution: 720p (1280x720) or lower (e.g. 854x480).
# - Codec: H.264 (AVC) baseline/main profile; avoid high bitrates (>5 Mbps) or HEVC/AV1.
# - Audio: Muted/none.

def find_backgrounds(configured_path, usb_dir):
    """Discovers background videos and images for idle attract screen.

    Policy:
    - Explicit BACKGROUND= path in config (file or directory).
    - USB / KATOYDATA roots: backgrounds/, images/, wallpapers/, videos/.
    - Default wallpaper image as last resort.
    - Videos are listed first; still images remain available as a fallback
      if mpv is unavailable or cannot open the selected video.
    """
    def filter_cand_dir(p):
        files = [f for f in p.iterdir() if f.is_file()]
        vids = sorted([f for f in files if f.suffix.lower() in VIDEO_EXTS])
        imgs = sorted([f for f in files if f.suffix.lower() in IMAGE_EXTS])
        # Keep still images available as a fallback if mpv cannot start.
        return vids + imgs

    if configured_path:
        p = Path(configured_path)
        if p.is_file() and p.suffix.lower() in ALL_BG_EXTS:
            return [p]
        elif p.is_dir():
            res = filter_cand_dir(p)
            if res:
                return res

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        for cand in [usb_root / "videos", usb_root / "backgrounds", usb_root / "images", usb_root / "wallpapers"]:
            if cand.is_dir():
                res = filter_cand_dir(cand)
                if res:
                    return res

    if DEFAULT_WALLPAPER.exists():
        return [DEFAULT_WALLPAPER]
    return []


def parse_filename_metadata(filepath):
    stem = filepath.stem
    has_explicit_code = False
    code_str = None
    title = stem
    artist = "Unknown Artist"

    m = re.match(r"^(\d+)\s*[-_]\s*(.+)$", stem)
    if m:
        c_code, rest = m.group(1), m.group(2)
        code_str = c_code.zfill(5)
        has_explicit_code = True
        if " - " in rest:
            parts = rest.split(" - ", 1)
            artist, title = parts[0].strip(), parts[1].strip()
        else:
            title = rest.strip()
    elif " - " in stem:
        parts = stem.split(" - ", 1)
        artist, title = parts[0].strip(), parts[1].strip()

    return has_explicit_code, code_str, title, artist


def load_midifile_robust(filepath):
    """Loads a MidiFile with clip=True and multi-encoding fallback (utf-8 -> cp1252 -> latin1)."""
    encodings = ['utf-8', 'cp1252', 'latin1']
    for enc in encodings:
        try:
            return mido.MidiFile(filepath, charset=enc, clip=True)
        except Exception:
            continue
    return mido.MidiFile(filepath, clip=True)



def extract_midi_vocal_gender(filepath, fallback="MALE"):
    """Read an optional singer-gender hint from MIDI text metadata.

    Supported tags: @GENDER=FEMALE/MALE, @SINGER=FEMALE/MALE,
    @SEX=F/M, and @V=F/M. Untagged files use the configured fallback;
    artist names are deliberately not guessed.
    """
    fallback = str(fallback or "MALE").strip().upper()
    if fallback in ("F", "FEMALE", "WOMAN", "W"):
        fallback = "FEMALE"
    elif fallback in ("M", "MALE", "MAN"):
        fallback = "MALE"
    else:
        fallback = "MALE"

    try:
        mid = load_midifile_robust(filepath)
    except Exception:
        return fallback

    for track in mid.tracks:
        for msg in track:
            if msg.type not in ("text", "lyrics", "track_name", "marker", "cue_marker"):
                continue
            value = getattr(msg, "text", getattr(msg, "name", "")) or ""
            match = re.match(r"^@(GENDER|SINGER|SEX|V)\s*[:=]\s*(FEMALE|MALE|F|M|WOMAN|MAN)\s*$", value.strip(), re.I)
            if match:
                token = match.group(2).upper()
                return "FEMALE" if token in ("F", "FEMALE", "WOMAN") else "MALE"
    return fallback


def calculate_elapsed_seconds(current_tick, total_ticks, song_duration):
    """Calculates elapsed audio position in seconds from FluidSynth ticks."""
    if total_ticks > 0 and current_tick >= 0:
        pct = max(0.0, min(1.0, current_tick / float(total_ticks)))
        return pct * song_duration
    return 0.0


def calculate_real_score(energy_samples, lyric_windows_count):
    """Calculates real VAD score based on mic energy samples during lyric windows."""
    if lyric_windows_count <= 0 or not energy_samples:
        return random.randint(85, 92)

    active_count = sum(1 for e in energy_samples if e > 0.1)
    coverage = active_count / float(max(1, len(energy_samples)))
    score = int(75 + (coverage * 25))
    return max(75, min(100, score))


def process_midi_file(src_path, dst_path, semi_tones, tempo_multiplier):
    if semi_tones == 0 and abs(tempo_multiplier - 1.0) < 1e-4:
        return src_path
    try:
        mid = load_midifile_robust(src_path)

        has_tempo_msg = any(msg.type == 'set_tempo' for track in mid.tracks for msg in track)

        for track in mid.tracks:
            for msg in track:
                if msg.type in ('note_on', 'note_off') and hasattr(msg, 'channel') and msg.channel != 9:
                    if semi_tones != 0:
                        msg.note = max(0, min(127, msg.note + semi_tones))
                elif msg.type == 'set_tempo' and abs(tempo_multiplier - 1.0) >= 1e-4:
                    msg.tempo = max(1, int(msg.tempo / tempo_multiplier))

        if not has_tempo_msg and abs(tempo_multiplier - 1.0) >= 1e-4:
            new_tempo = max(1, int(500000 / tempo_multiplier))
            if mid.tracks:
                mid.tracks[0].insert(0, mido.MetaMessage('set_tempo', tempo=new_tempo, time=0))

        mid.save(dst_path)
        return dst_path
    except Exception as e:
        print(f"MIDI process error: {e}")
        return src_path


def pitch_transpose_midi_file(src_path, dst_path, semi_tones):
    return process_midi_file(src_path, dst_path, semi_tones, 1.0)


def extract_midi_lyrics_and_duration(filepath):
    try:
        mid = load_midifile_robust(filepath)
    except Exception as e:
        return [], 0.0, Path(filepath).stem, ""

    ticks_per_beat = mid.ticks_per_beat or 480

    tempo_changes = []
    max_ticks = 0
    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type == 'set_tempo':
                tempo_changes.append((abs_tick, msg.tempo))
        if abs_tick > max_ticks:
            max_ticks = abs_tick

    tempo_changes.sort(key=lambda x: x[0])
    if not tempo_changes or tempo_changes[0][0] > 0:
        tempo_changes.insert(0, (0, 500000))

    def tick_to_sec(target_tick):
        sec = 0.0
        last_tick = 0
        last_tempo = 500000
        for t_tick, t_tempo in tempo_changes:
            if t_tick >= target_tick:
                break
            sec += ((t_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
            last_tick = t_tick
            last_tempo = t_tempo
        sec += ((target_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
        return sec

    total_duration = tick_to_sec(max_ticks)

    lyric_events = []
    text_fallback_events = []
    meta_title = ""
    meta_artist = ""

    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type not in ('lyrics', 'text'):
                continue
            raw_txt = (msg.text or "").replace("\x00", "")
            txt = raw_txt.strip()
            if not txt:
                continue
            if txt.startswith('@T'):
                t_val = txt[2:].strip()
                if not meta_title:
                    meta_title = t_val
                elif not meta_artist:
                    meta_artist = t_val
                continue
            if txt.startswith('@'):
                continue

            event = (tick_to_sec(abs_tick), raw_txt)
            if msg.type == 'lyrics':
                lyric_events.append(event)
            else:
                # Generic MIDI text often contains labels such as "any",
                # copyright, or track annotations. Use it only when the file
                # has no actual lyric meta events at all.
                text_fallback_events.append(event)

    raw_syllables = lyric_events if lyric_events else text_fallback_events
    raw_syllables.sort(key=lambda x: x[0])

    lines = []
    cur_syls = []

    def flush_line():
        nonlocal cur_syls
        if cur_syls:
            line_str = "".join(item['text'] for item in cur_syls).strip()
            if line_str:
                lines.append({
                    'text': line_str,
                    'syllables': cur_syls,
                    'start_sec': cur_syls[0]['sec'],
                })
            cur_syls = []

    # KAR/MIDI karaoke files use slash, backslash, or newline markers for
    # line breaks. A marker may be a separate event OR attached to either
    # end of a lyric event; handle both forms so lines don't collapse into
    # one long first line.
    for sec, txt in raw_syllables:
        chunk = []
        for char in txt:
            if char in ('/', "\\", "\r", "\n"):
                if chunk:
                    part = "".join(chunk)
                    if part.strip():
                        cur_syls.append({'sec': sec, 'text': part})
                    chunk = []
                flush_line()
            else:
                chunk.append(char)
        if chunk:
            part = "".join(chunk)
            if part.strip():
                cur_syls.append({'sec': sec, 'text': part})

    flush_line()

    return lines, total_duration, meta_title, meta_artist


class SongDatabase:
    def __init__(self, db_path):
        self.db_path = db_path
        # The phone remote queries from HTTP worker threads, so allow cross-thread use and serialise access.
        self.conn = sqlite3.connect(db_path, check_same_thread=False)
        self._lock = threading.RLock()
        self.create_tables()

    def create_tables(self):
        with self.conn:
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS songs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    code TEXT,
                    title TEXT,
                    artist TEXT,
                    filepath TEXT UNIQUE,
                    mtime REAL,
                    size INTEGER DEFAULT 0
                )
            """)
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS code_mapping (
                    filepath TEXT PRIMARY KEY,
                    code TEXT
                )
            """)
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_code ON songs(code)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_title ON songs(title)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_artist ON songs(artist)")

    def index_songs(self, songs_dir, force=False, progress_callback=None):
        if isinstance(songs_dir, (list, tuple)):
            dirs = [Path(d) for d in songs_dir if Path(d).exists()]
        else:
            p = Path(songs_dir)
            dirs = [p] if p.exists() else []

        if not dirs:
            return 0

        audio_files = []
        seen_paths = set()
        total_disk_size = 0
        latest_on_disk_mtime = 0.0

        for d in dirs:
            for root, _, files in os.walk(d):
                for f in files:
                    if f.lower().endswith((".mid", ".kar")):
                        fp = Path(root) / f
                        if fp not in seen_paths:
                            seen_paths.add(fp)
                            audio_files.append(fp)
                            try:
                                st = fp.stat()
                                total_disk_size += st.st_size
                                if st.st_mtime > latest_on_disk_mtime:
                                    latest_on_disk_mtime = st.st_mtime
                            except Exception:
                                pass

        audio_files.sort()

        if not force:
            cur = self.conn.cursor()
            try:
                cur.execute("SELECT COUNT(*), MAX(mtime), SUM(size) FROM songs")
                row = cur.fetchone()
                count, max_mtime, sum_size = row[0], row[1], (row[2] or 0)
                if count == len(audio_files) and count > 0 and max_mtime is not None:
                    if latest_on_disk_mtime <= max_mtime and sum_size == total_disk_size:
                        return count
            except Exception:
                pass

        cur = self.conn.cursor()
        cur.execute("SELECT filepath, code FROM code_mapping")
        existing_mappings = dict(cur.fetchall())

        used_codes = set(existing_mappings.values())

        with self.conn:
            self.conn.execute("DELETE FROM songs")
            items = []
            next_auto_code = 1

            total_files = len(audio_files)
            for idx_fp, fp in enumerate(audio_files, 1):
                if progress_callback and total_files > 0 and idx_fp % 50 == 0:
                    progress_callback(idx_fp, total_files)

                fp_str = str(fp)
                try:
                    st = fp.stat()
                    mtime = st.st_mtime
                    fsize = st.st_size
                except Exception:
                    mtime = 0.0
                    fsize = 0

                has_explicit, code_str, title, artist = parse_filename_metadata(fp)

                if has_explicit:
                    code = code_str
                elif fp_str in existing_mappings:
                    code = existing_mappings[fp_str]
                else:
                    while f"{next_auto_code:05d}" in used_codes:
                        next_auto_code += 1
                    code = f"{next_auto_code:05d}"
                    used_codes.add(code)
                    existing_mappings[fp_str] = code
                    next_auto_code += 1

                self.conn.execute(
                    "INSERT OR REPLACE INTO code_mapping (filepath, code) VALUES (?, ?)",
                    (fp_str, code)
                )

                items.append((code, title, artist, fp_str, mtime, fsize))

            self.conn.executemany("""
                INSERT OR REPLACE INTO songs (code, title, artist, filepath, mtime, size)
                VALUES (?, ?, ?, ?, ?, ?)
            """, items)

        return len(audio_files)

    def search(self, query="", offset=0, limit=1000):
        with self._lock:
            cur = self.conn.cursor()
            q_str = query.strip()
            if not q_str:
                cur.execute("SELECT COUNT(*) FROM songs")
                total = cur.fetchone()[0]
                cur.execute("SELECT code, title, artist, filepath FROM songs ORDER BY code ASC LIMIT ? OFFSET ?", (limit, offset))
                rows = cur.fetchall()
            else:
                q = f"%{q_str}%"
                cur.execute("""
                    SELECT COUNT(*) FROM songs
                    WHERE code LIKE ? OR title LIKE ? OR artist LIKE ? OR filepath LIKE ?
                """, (q, q, q, q))
                total = cur.fetchone()[0]
                cur.execute("""
                    SELECT code, title, artist, filepath FROM songs
                    WHERE code LIKE ? OR title LIKE ? OR artist LIKE ? OR filepath LIKE ?
                    ORDER BY code ASC LIMIT ? OFFSET ?
                """, (q, q, q, q, limit, offset))
                rows = cur.fetchall()
            return {"songs": rows, "total": total}

    def get_by_code(self, code_str):
        with self._lock:
            cur = self.conn.cursor()
            c = code_str.zfill(5)
            cur.execute("SELECT code, title, artist, filepath FROM songs WHERE code = ? LIMIT 1", (c,))
            return cur.fetchone()

    def close(self):
        self.conn.close()


