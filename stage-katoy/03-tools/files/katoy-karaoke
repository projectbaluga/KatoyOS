        QTimer.singleShot(0, self._late_init)

    # ── startup (deferred) ──────────────────────────────────────────────────────
    def _late_init(self):
        if self.config.get("REMOTE_ENABLED", "1") == "1":
            try:
                r_port = int(self.config.get("REMOTE_PORT", "8080"))
                self.remote_server = RemoteWebServer(r_port, self.config.get("REMOTE_PIN", ""), self, self.remote_signals)
                self.remote_server.start()
            except Exception as e:
                print(f"Remote server failed to start: {e}")

        self.net_watcher = NetworkWatcher(self.config)
        self.net_watcher.changed.connect(self.on_network_changed)
        self.net_watcher.start()

        self.check_usb_and_media()
        self.poll_timer.start(2000)

        # PipeWire starts in parallel with us at boot; retry until it answers.
        self._try_audio_setup()

        # systemd-analyze only has a number once boot has finished, and it is slow: ask later, off-thread.
        QTimer.singleShot(25000, self._measure_boot_time)

    def _try_audio_setup(self):
        if self._audio_ready:
            return
        self._audio_tries += 1
        ok = True
        if shutil.which("pactl"):
            try:
                ok = subprocess.run(["pactl", "info"], capture_output=True, timeout=3).returncode == 0
            except Exception:
                ok = False
        if ok:
            self.mic_manager.select_output_sink()
            self.mic_manager.apply_settings()
            self.mic_manager.set_music_volume(self.mic_manager.music_volume)
            self._audio_ready = True
        elif self._audio_tries < 40:
            QTimer.singleShot(1500, self._try_audio_setup)

    def _measure_boot_time(self):
        self._boot_worker = FuncWorker(get_systemd_boot_time)
        self._boot_worker.result.connect(self._on_boot_time)
        self._boot_worker.start()

    def _on_boot_time(self, text):
        self.boot_info = text
        if hasattr(self, "sys_boot_val"):
            self.sys_boot_val.setText(text)

