    def _build_gradient_bg(self, size):
        pm = QPixmap(size)
        p = QPainter(pm)
        w, h = size.width(), size.height()
        g = QLinearGradient(0, 0, 0, h)
        g.setColorAt(0, COL_BG_TOP)
        g.setColorAt(1, COL_BG_BOTTOM)
        p.fillRect(0, 0, w, h, g)
        for cx, cy, rad, col in ((0.12, 0.05, 0.75, QColor(255, 46, 147, 70)),
                                 (0.95, 0.98, 0.80, QColor(34, 211, 238, 52)),
                                 (0.80, 0.10, 0.45, QColor(139, 60, 240, 60))):
            rg = QRadialGradient(w * cx, h * cy, max(w, h) * rad)
            rg.setColorAt(0, col)
            rg.setColorAt(1, QColor(col.red(), col.green(), col.blue(), 0))
            p.fillRect(0, 0, w, h, rg)
        p.end()
        return pm

    def _build_cover_bg(self, size):
        src = self._cover_src
        scaled = src.scaled(size, Qt.AspectRatioMode.KeepAspectRatioByExpanding, Qt.TransformationMode.SmoothTransformation)
        x = (scaled.width() - size.width()) // 2
        y = (scaled.height() - size.height()) // 2
        pm = scaled.copy(x, y, size.width(), size.height())
        p = QPainter(pm)
        g = QLinearGradient(0, 0, 0, size.height())
        g.setColorAt(0.0, QColor(10, 6, 31, 150))
        g.setColorAt(0.45, QColor(10, 6, 31, 110))
        g.setColorAt(1.0, QColor(10, 6, 31, 215))
        p.fillRect(pm.rect(), g)
        p.fillRect(pm.rect(), QColor(60, 20, 110, 55))
        p.end()
        return pm

    def paintEvent(self, ev):
        p = QPainter(self)
        size = self.size()
        # If an embedded mpv video process is actively running, do not paint an opaque full cover over it
        video_active = self.bg_video_proc and self.bg_video_proc.poll() is None
        if video_active:
            p.fillRect(0, 0, size.width(), size.height(), QColor(10, 6, 31, 90))
            return

        show_bg = self._cover_src is not None and not self._cover_src.isNull()
        if show_bg:
            if self._cover_cache is None or self._cover_cache.size() != size:
                self._cover_cache = self._build_cover_bg(size)
            p.drawPixmap(0, 0, self._cover_cache)
        else:
            if self._grad_cache is None or self._grad_cache.size() != size:
                self._grad_cache = self._build_gradient_bg(size)
            p.drawPixmap(0, 0, self._grad_cache)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._grad_cache = None
        self._cover_cache = None

