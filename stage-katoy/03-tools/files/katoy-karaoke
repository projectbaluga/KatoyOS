class SongIndexerWorker(QThread):
    """Background thread worker for indexing song library and searching media assets."""

    progress = pyqtSignal(int, int)
    finished = pyqtSignal(int, object, object, str)

    def __init__(self, usb_dir, config, force=False):
        super().__init__()
        self.usb_dir = Path(usb_dir)
        self.config = config
        self.force = force

    def run(self):
        first_dir = self.usb_dir[0] if isinstance(self.usb_dir, (list, tuple)) else self.usb_dir
        db_path = (first_dir / ".katoy-karaoke.db") if first_dir.is_dir() else (first_dir.parent / ".katoy-karaoke.db")
        db_instance = None
        count = 0
        read_only_msg = ""

        def prog_cb(cur, total):
            self.progress.emit(cur, total)

        try:
            db_instance = SongDatabase(db_path)
            count = db_instance.index_songs(self.usb_dir, force=self.force, progress_callback=prog_cb)
        except Exception:
            if db_instance:
                try:
                    db_instance.close()
                except Exception:
                    pass
                db_instance = None

        if not db_instance:
            fallback_dir = Path("/tmp/katoy_karaoke")
            try:
                fallback_dir.mkdir(parents=True, exist_ok=True)
                safe_name = re.sub(r'[^a-zA-Z0-9_-]', '_', first_dir.name)
                fallback_db_path = fallback_dir / f".katoy-karaoke-{safe_name}.db"
                db_instance = SongDatabase(fallback_db_path)
                count = db_instance.index_songs(self.usb_dir, force=self.force, progress_callback=prog_cb)
                read_only_msg = " (read-only mode)"
            except Exception as e:
                print(f"Fallback indexing failed: {e}")

        usb_ref = first_dir
        sf = find_soundfont(self.config.get("SOUNDFONT"), usb_ref)
        bgs = find_backgrounds(self.config.get("BACKGROUND"), usb_ref)

        self.finished.emit(count, sf, bgs, read_only_msg)

