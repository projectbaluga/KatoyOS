class RemoteBridgeSignals(QObject):
    reserve_song = pyqtSignal(tuple)
    adjust_key = pyqtSignal(int)
    adjust_tempo = pyqtSignal(float)
    skip_song = pyqtSignal()
    toggle_pause = pyqtSignal()
    adjust_mic_vol = pyqtSignal(int)
    adjust_music_vol = pyqtSignal(int)


class RemoteRequestHandler(BaseHTTPRequestHandler):
    bridge_signals = None
    app_instance = None
    pin = ""

    def log_message(self, format, *args):
        pass

    def send_json(self, data, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode("utf-8"))

    def send_html(self, page, code=200):
        body = page.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        app = self.app_instance

        # REMOTE_PIN gates the player API. First-time Wi-Fi setup (/wifi, /setup, status polling) stays open
        # only while the box is in hotspot mode, so a phone that just scanned the QR code can configure it.
        setup_paths = ("/wifi", "/setup", "/wifi/status", "/api/wifi-status")
        setup_open = path in setup_paths and bool(app and getattr(app, "net_ap", False))
        if self.pin and not setup_open and params.get("pin", [""])[0] != self.pin:
            self.send_json({"error": "Unauthorized / Invalid PIN"}, 401)
            return

        if path == "/":
            self.send_html(REMOTE_HTML)
        elif path == "/api/search":
            q = params.get("q", [""])[0]
            try:
                offset = int(params.get("offset", ["0"])[0])
            except ValueError:
                offset = 0
            try:
                limit = int(params.get("limit", ["20"])[0])
            except ValueError:
                limit = 20
            self.send_json(app.db.search(q, offset=offset, limit=limit) if (app and app.db) else {"songs": [], "total": 0})
        elif path == "/api/reserve":
            # The phone only sends a song *code*; the file path always comes from our own index.
            code = params.get("code", [""])[0].strip()
            song = app.db.get_by_code(code) if (app and app.db and code) else None
            if song and self.bridge_signals:
                self.bridge_signals.reserve_song.emit(tuple(song))
                self.send_json({"status": "ok", "msg": f"Reserved: [{song[0]}] {song[1]}"})
            else:
                self.send_json({"error": "Unknown song code"}, 404)
        elif path == "/api/queue":
            self.send_json([list(s[:3]) for s in list(app.reservation_queue)] if app else [])
        elif path == "/api/state":
            cur = app.current_song if app else None
            self.send_json({
                "playing": bool(app and app.is_playing),
                "paused": bool(app and app.is_paused),
                "code": cur[0] if cur else "",
                "title": cur[1] if cur else "",
                "artist": cur[2] if cur else "",
                "key": app.pitch_key if app else 0,
                "tempo": int(round(app.tempo_multiplier * 100)) if app else 100,
                "queue": [list(s[:3]) for s in list(app.reservation_queue)] if app else [],
            })
        elif path in ("/api/key", "/api/tempo"):
            try:
                d = int(params.get("delta", ["0"])[0]) if path == "/api/key" else float(params.get("delta", ["0"])[0])
            except ValueError:
                self.send_json({"error": "Bad delta"}, 400)
                return
            if self.bridge_signals:
                (self.bridge_signals.adjust_key if path == "/api/key" else self.bridge_signals.adjust_tempo).emit(d)
            self.send_json({"status": "ok"})
        elif path == "/api/skip":
            if self.bridge_signals:
                self.bridge_signals.skip_song.emit()
            self.send_json({"status": "ok"})
        elif path == "/api/pause":
            if self.bridge_signals:
                self.bridge_signals.toggle_pause.emit()
            self.send_json({"status": "ok"})
        elif path in ("/wifi/status", "/api/wifi-status"):
            status_file = Path("/tmp/katoy-wifi-status.json")
            if status_file.exists():
                try:
                    data = json.loads(status_file.read_text(encoding="utf-8"))
                    self.send_json(data)
                except Exception:
                    self.send_json({"status": "unknown"}, 200)
            else:
                self.send_json({"status": "pending", "msg": "No connection attempt recorded yet"}, 200)
        elif path in ("/wifi", "/setup"):
            ssid = params.get("ssid", [""])[0]
            passw = params.get("password", [""])[0]
            if ssid:
                try:
                    subprocess.run(
                        ["pkexec", "/usr/lib/katoyos/helper", "set-wifi-credentials", ssid, passw],
                        check=True
                    )
                    self.send_json({"status": "ok", "msg": f"Wi-Fi credentials for {ssid} applied! Connecting..."})
                except Exception as e:
                    self.send_json({"error": f"Failed to connect: {e}"}, 500)
            else:
                # GET /wifi: serve the setup page with an SSID scan
                wifi_out = ""
                if shutil.which("nmcli"):
                    try:
                        res = subprocess.run(["nmcli", "-t", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list"], capture_output=True, text=True)
                        wifi_out = res.stdout
                    except Exception:
                        pass
                ssids = parse_nmcli_wifi_list(wifi_out)
                opts = "".join(f"<option value='{html.escape(s, quote=True)}'>{html.escape(s)}</option>" for s in ssids) \
                    if ssids else "<option value=''>No networks found</option>"
                self.send_html(WIFI_HTML.replace("__SSID_OPTIONS__", opts))
        else:
            self.send_json({"error": "Not Found"}, 404)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True


class RemoteWebServer(QThread):
    def __init__(self, port, pin, app_instance, bridge_signals):
        super().__init__()
        self.port = port
        self.pin = pin
        self.app_instance = app_instance
        self.bridge_signals = bridge_signals
        self.httpd = None

    def run(self):
        handler_class = RemoteRequestHandler
        handler_class.app_instance = self.app_instance
        handler_class.bridge_signals = self.bridge_signals
        handler_class.pin = self.pin

        # Bind every interface: at boot we usually start before Wi-Fi has an address (and the setup
        # hotspot appears later still), so binding to the IP present *now* would strand the phone remote.
        bind_ip = "0.0.0.0"
        try:
            self.httpd = ThreadedHTTPServer((bind_ip, self.port), handler_class)
            print(f"Phone remote web server listening on {bind_ip}:{self.port}")
            self.httpd.serve_forever()
        except Exception as e:
            print(f"RemoteWebServer error: {e}")

    def stop(self):
        if self.httpd:
            try:
                self.httpd.shutdown()
                self.httpd.server_close()
            except Exception:
                pass


class MicrophoneChainManager:
    """Manages PipeWire/PulseAudio mic-to-output loopback, volume, mute, and sink selection."""

    def __init__(self, config):
        self.config = config
        self.loopback_module_id = None
        self.is_muted = False
        self.mic_volume = int(config.get("MIC_VOLUME", "80"))
        self.music_volume = int(config.get("MUSIC_VOLUME", "100"))
        self.reverb_enabled = (config.get("MIC_REVERB", "1") == "1")
        self.mic_enabled = (config.get("MIC_ENABLED", "1") == "1")
        self.output_device = config.get("OUTPUT_DEVICE", "auto")

    def apply_settings(self):
        if not self.mic_enabled:
            self.stop_loopback()
            return

        if shutil.which("pactl"):
            try:
                if self.loopback_module_id is None:
                    res = subprocess.run(
                        ["pactl", "load-module", "module-loopback", "latency_msec=20"],
                        capture_output=True, text=True
                    )
                    if res.returncode == 0 and res.stdout.strip().isdigit():
                        self.loopback_module_id = res.stdout.strip()

                val = 0 if self.is_muted else self.mic_volume
                subprocess.run(["pactl", "set-source-volume", "@DEFAULT_SOURCE@", f"{val}%"], stderr=subprocess.DEVNULL)
                subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "1" if self.is_muted else "0"], stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"MicrophoneChainManager pactl error: {e}")

    def set_mic_volume(self, volume):
        self.mic_volume = max(0, min(100, volume))
        self.apply_settings()

    def set_music_volume(self, volume):
        self.music_volume = max(0, min(100, volume))
        if shutil.which("pactl"):
            try:
                subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{self.music_volume}%"], stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def toggle_mute(self):
        self.is_muted = not self.is_muted
        self.apply_settings()
        return self.is_muted

    def set_output_device(self, device_name):
        self.output_device = device_name
        if shutil.which("pactl") and device_name != "auto":
            try:
                subprocess.run(["pactl", "set-default-sink", device_name], stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def stop_loopback(self):
        if self.loopback_module_id and shutil.which("pactl"):
            try:
                subprocess.run(["pactl", "unload-module", self.loopback_module_id], stderr=subprocess.DEVNULL)
            except Exception:
                pass
            self.loopback_module_id = None


def load_config(usb_dir=None):
    cfg = {
        "SONGS_DIR": "auto",
        "SOUNDFONT": "",
        "BACKGROUND": "",
        "AUDIO_DRIVER": "pulseaudio",
        "FULLSCREEN": "1",
        "KIOSK": "0",
        "MIC_ENABLED": "1",
        "MIC_VOLUME": "80",
        "MUSIC_VOLUME": "100",
        "MIC_REVERB": "1",
        "OUTPUT_DEVICE": "auto",
        "REMOTE_ENABLED": "1",
        "REMOTE_PORT": "8080",
        "REMOTE_PIN": "",
        "SCORING_MODE": "real",
    }
    if CONFIG_FILE.exists():
        try:
            for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
        except Exception as e:
            print(f"Error reading {CONFIG_FILE}: {e}")

    # USB Cascading Override
    if usb_dir:
        u_path = Path(usb_dir)
        usb_root = u_path.parent if u_path.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else u_path
        for conf_name in (".katoy-karaoke.conf", "karaoke.conf", "katoy-karaoke.conf"):
            u_conf = usb_root / conf_name
            if u_conf.is_file():
                try:
                    for line in u_conf.read_text(encoding="utf-8").splitlines():
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            cfg[k.strip()] = v.strip()
                except Exception as e:
                    print(f"Error reading USB config {u_conf}: {e}")
                break

    return cfg


def detect_usb_songs_dir():
    mount_roots = [Path("/media/katoy"), Path("/media"), Path("/run/media/katoy"), Path("/mnt")]
    candidate_subdirs = ["songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR"]

    for root in mount_roots:
        if not root.exists():
            continue
        for drive in root.iterdir():
            if drive.is_dir() and drive.name not in ("cdrom", "floppy"):
                for sub in candidate_subdirs:
                    s_path = drive / sub
                    if s_path.is_dir():
                        return s_path
                try:
                    for f in drive.glob("*"):
                        if f.is_file() and f.suffix.lower() in (".mid", ".kar"):
                            return drive
                        elif f.is_dir() and not f.name.startswith("."):
                            for sf in f.glob("*"):
                                if sf.is_file() and sf.suffix.lower() in (".mid", ".kar"):
                                    return drive
                except Exception:
                    pass
    return None


_SOUNDFONT_CACHE = {}


def find_soundfont(configured_path, usb_dir):
    if configured_path and Path(configured_path).exists():
        return Path(configured_path)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        cache_key = str(usb_root.resolve())
        if cache_key in _SOUNDFONT_CACHE:
            cached = _SOUNDFONT_CACHE[cache_key]
            if cached and cached.exists():
                return cached

        # Shallow search up to depth 2 to avoid blocking the UI poll loop on large drives
        sf_found = None
        try:
            for item in usb_root.iterdir():
                if item.is_file() and item.suffix.lower() == ".sf2":
                    sf_found = item
                    break
                elif item.is_dir() and not item.name.startswith("."):
                    for subitem in item.iterdir():
                        if subitem.is_file() and subitem.suffix.lower() == ".sf2":
                            sf_found = subitem
                            break
                    if sf_found:
                        break
        except Exception:
            pass

        _SOUNDFONT_CACHE[cache_key] = sf_found
        if sf_found:
            return sf_found

    for sys_sf in SYSTEM_SOUNDFONTS:
        if sys_sf.exists():
            return sys_sf

    return None


def find_backgrounds(configured_path, usb_dir):
    bg_list = []
    if configured_path:
        p = Path(configured_path)
        if p.is_file() and p.suffix.lower() in (".png", ".jpg", ".jpeg"):
            return [p]
        elif p.is_dir():
            bg_list = [f for f in p.iterdir() if f.suffix.lower() in (".png", ".jpg", ".jpeg")]
            if bg_list:
                return sorted(bg_list)

    if usb_dir and usb_dir.exists():
        usb_root = usb_dir.parent if usb_dir.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else usb_dir
        for cand in [usb_root / "backgrounds", usb_root / "images", usb_root / "wallpapers"]:
            if cand.is_dir():
                imgs = [f for f in cand.iterdir() if f.suffix.lower() in (".png", ".jpg", ".jpeg")]
                if imgs:
                    return sorted(imgs)

    if DEFAULT_WALLPAPER.exists():
        return [DEFAULT_WALLPAPER]
    return []


def parse_filename_metadata(filepath):
    stem = filepath.stem
    has_explicit_code = False
    code_str = None
    title = stem
    artist = "Unknown Artist"

    m = re.match(r"^(\d+)\s*[-_]\s*(.+)$", stem)
    if m:
        c_code, rest = m.group(1), m.group(2)
        code_str = c_code.zfill(5)
        has_explicit_code = True
        if " - " in rest:
            parts = rest.split(" - ", 1)
            artist, title = parts[0].strip(), parts[1].strip()
        else:
            title = rest.strip()
    elif " - " in stem:
        parts = stem.split(" - ", 1)
        artist, title = parts[0].strip(), parts[1].strip()

    return has_explicit_code, code_str, title, artist


def load_midifile_robust(filepath):
    """Loads a MidiFile with clip=True and multi-encoding fallback (utf-8 -> cp1252 -> latin1)."""
    encodings = ['utf-8', 'cp1252', 'latin1']
    for enc in encodings:
        try:
            return mido.MidiFile(filepath, charset=enc, clip=True)
        except Exception:
            continue
    return mido.MidiFile(filepath, clip=True)


def calculate_elapsed_seconds(current_tick, total_ticks, song_duration):
    """Calculates elapsed audio position in seconds from FluidSynth ticks."""
    if total_ticks > 0 and current_tick >= 0:
        pct = max(0.0, min(1.0, current_tick / float(total_ticks)))
        return pct * song_duration
    return 0.0


def calculate_real_score(energy_samples, lyric_windows_count):
    """Calculates real VAD score based on mic energy samples during lyric windows."""
    if lyric_windows_count <= 0 or not energy_samples:
        return random.randint(85, 92)

    active_count = sum(1 for e in energy_samples if e > 0.1)
    coverage = active_count / float(max(1, len(energy_samples)))
    score = int(75 + (coverage * 25))
    return max(75, min(100, score))


def process_midi_file(src_path, dst_path, semi_tones, tempo_multiplier):
    if semi_tones == 0 and abs(tempo_multiplier - 1.0) < 1e-4:
        return src_path
    try:
        mid = load_midifile_robust(src_path)

        has_tempo_msg = any(msg.type == 'set_tempo' for track in mid.tracks for msg in track)

        for track in mid.tracks:
            for msg in track:
                if msg.type in ('note_on', 'note_off') and hasattr(msg, 'channel') and msg.channel != 9:
                    if semi_tones != 0:
                        msg.note = max(0, min(127, msg.note + semi_tones))
                elif msg.type == 'set_tempo' and abs(tempo_multiplier - 1.0) >= 1e-4:
                    msg.tempo = max(1, int(msg.tempo / tempo_multiplier))

        if not has_tempo_msg and abs(tempo_multiplier - 1.0) >= 1e-4:
            new_tempo = max(1, int(500000 / tempo_multiplier))
            if mid.tracks:
                mid.tracks[0].insert(0, mido.MetaMessage('set_tempo', tempo=new_tempo, time=0))

        mid.save(dst_path)
        return dst_path
    except Exception as e:
        print(f"MIDI process error: {e}")
        return src_path


def pitch_transpose_midi_file(src_path, dst_path, semi_tones):
    return process_midi_file(src_path, dst_path, semi_tones, 1.0)


def extract_midi_lyrics_and_duration(filepath):
    try:
        mid = load_midifile_robust(filepath)
    except Exception as e:
        return [], 0.0, Path(filepath).stem, ""

    ticks_per_beat = mid.ticks_per_beat or 480

    tempo_changes = []
    max_ticks = 0
    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type == 'set_tempo':
                tempo_changes.append((abs_tick, msg.tempo))
        if abs_tick > max_ticks:
            max_ticks = abs_tick

    tempo_changes.sort(key=lambda x: x[0])
    if not tempo_changes or tempo_changes[0][0] > 0:
        tempo_changes.insert(0, (0, 500000))

    def tick_to_sec(target_tick):
        sec = 0.0
        last_tick = 0
        last_tempo = 500000
        for t_tick, t_tempo in tempo_changes:
            if t_tick >= target_tick:
                break
            sec += ((t_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
            last_tick = t_tick
            last_tempo = t_tempo
        sec += ((target_tick - last_tick) * last_tempo) / (ticks_per_beat * 1000000.0)
        return sec

    total_duration = tick_to_sec(max_ticks)

    raw_syllables = []
    meta_title = ""
    meta_artist = ""

    for track in mid.tracks:
        abs_tick = 0
        for msg in track:
            abs_tick += msg.time
            if msg.type in ('lyrics', 'text'):
                txt = msg.text
                if not txt:
                    continue
                if txt.startswith('@T'):
                    t_val = txt[2:].strip()
                    if not meta_title:
                        meta_title = t_val
                    elif not meta_artist:
                        meta_artist = t_val
                elif txt.startswith('@'):
                    continue
                else:
                    sec = tick_to_sec(abs_tick)
                    raw_syllables.append((sec, txt))

    raw_syllables.sort(key=lambda x: x[0])

    lines = []
    cur_syls = []

    for sec, txt in raw_syllables:
        is_break = False
        clean_txt = txt
        if txt.startswith('/') or txt.startswith('\\'):
            is_break = True
            clean_txt = txt[1:]
        elif '\n' in txt or '\r' in txt:
            is_break = True
            clean_txt = txt.replace('\n', '').replace('\r', '')

        if is_break and cur_syls:
            line_str = "".join(s['text'] for s in cur_syls)
            lines.append({'text': line_str, 'syllables': cur_syls, 'start_sec': cur_syls[0]['sec']})
            cur_syls = []

        if clean_txt:
            cur_syls.append({'sec': sec, 'text': clean_txt})

    if cur_syls:
        line_str = "".join(s['text'] for s in cur_syls)
        lines.append({'text': line_str, 'syllables': cur_syls, 'start_sec': cur_syls[0]['sec']})

    return lines, total_duration, meta_title, meta_artist


class SongDatabase:
    def __init__(self, db_path):
        self.db_path = db_path
        # The phone remote queries from HTTP worker threads, so allow cross-thread use and serialise access.
        self.conn = sqlite3.connect(db_path, check_same_thread=False)
        self._lock = threading.RLock()
        self.create_tables()

    def create_tables(self):
        with self.conn:
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS songs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    code TEXT,
                    title TEXT,
                    artist TEXT,
                    filepath TEXT UNIQUE,
                    mtime REAL,
                    size INTEGER DEFAULT 0
                )
            """)
            self.conn.execute("""
                CREATE TABLE IF NOT EXISTS code_mapping (
                    filepath TEXT PRIMARY KEY,
                    code TEXT
                )
            """)
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_code ON songs(code)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_title ON songs(title)")
            self.conn.execute("CREATE INDEX IF NOT EXISTS idx_artist ON songs(artist)")

    def index_songs(self, songs_dir, force=False, progress_callback=None):
        if isinstance(songs_dir, (list, tuple)):
            dirs = [Path(d) for d in songs_dir if Path(d).exists()]
        else:
            p = Path(songs_dir)
            dirs = [p] if p.exists() else []

        if not dirs:
            return 0

        audio_files = []
        seen_paths = set()
        total_disk_size = 0
        latest_on_disk_mtime = 0.0

        for d in dirs:
            for root, _, files in os.walk(d):
                for f in files:
                    if f.lower().endswith((".mid", ".kar")):
                        fp = Path(root) / f
                        if fp not in seen_paths:
                            seen_paths.add(fp)
                            audio_files.append(fp)
                            try:
                                st = fp.stat()
                                total_disk_size += st.st_size
                                if st.st_mtime > latest_on_disk_mtime:
                                    latest_on_disk_mtime = st.st_mtime
                            except Exception:
                                pass

        audio_files.sort()

        if not force:
            cur = self.conn.cursor()
            try:
                cur.execute("SELECT COUNT(*), MAX(mtime), SUM(size) FROM songs")
                row = cur.fetchone()
                count, max_mtime, sum_size = row[0], row[1], (row[2] or 0)
                if count == len(audio_files) and count > 0 and max_mtime is not None:
                    if latest_on_disk_mtime <= max_mtime and sum_size == total_disk_size:
                        return count
            except Exception:
                pass

        cur = self.conn.cursor()
        cur.execute("SELECT filepath, code FROM code_mapping")
        existing_mappings = dict(cur.fetchall())

        used_codes = set(existing_mappings.values())

        with self.conn:
            self.conn.execute("DELETE FROM songs")
            items = []
            next_auto_code = 1

            total_files = len(audio_files)
            for idx_fp, fp in enumerate(audio_files, 1):
                if progress_callback and total_files > 0 and idx_fp % 50 == 0:
                    progress_callback(idx_fp, total_files)

                fp_str = str(fp)
                try:
                    st = fp.stat()
                    mtime = st.st_mtime
                    fsize = st.st_size
                except Exception:
                    mtime = 0.0
                    fsize = 0

                has_explicit, code_str, title, artist = parse_filename_metadata(fp)

                if has_explicit:
                    code = code_str
                elif fp_str in existing_mappings:
                    code = existing_mappings[fp_str]
                else:
                    while f"{next_auto_code:05d}" in used_codes:
                        next_auto_code += 1
                    code = f"{next_auto_code:05d}"
                    used_codes.add(code)
                    existing_mappings[fp_str] = code
                    next_auto_code += 1

                self.conn.execute(
                    "INSERT OR REPLACE INTO code_mapping (filepath, code) VALUES (?, ?)",
                    (fp_str, code)
                )

                items.append((code, title, artist, fp_str, mtime, fsize))

            self.conn.executemany("""
                INSERT OR REPLACE INTO songs (code, title, artist, filepath, mtime, size)
                VALUES (?, ?, ?, ?, ?, ?)
            """, items)

        return len(audio_files)

    def search(self, query="", offset=0, limit=1000):
        with self._lock:
            cur = self.conn.cursor()
            q_str = query.strip()
            if not q_str:
                cur.execute("SELECT COUNT(*) FROM songs")
                total = cur.fetchone()[0]
                cur.execute("SELECT code, title, artist, filepath FROM songs ORDER BY code ASC LIMIT ? OFFSET ?", (limit, offset))
                rows = cur.fetchall()
            else:
                q = f"%{q_str}%"
                cur.execute("""
                    SELECT COUNT(*) FROM songs
                    WHERE code LIKE ? OR title LIKE ? OR artist LIKE ? OR filepath LIKE ?
                """, (q, q, q, q))
                total = cur.fetchone()[0]
                cur.execute("""
                    SELECT code, title, artist, filepath FROM songs
                    WHERE code LIKE ? OR title LIKE ? OR artist LIKE ? OR filepath LIKE ?
                    ORDER BY code ASC LIMIT ? OFFSET ?
                """, (q, q, q, q, limit, offset))
                rows = cur.fetchall()
            return {"songs": rows, "total": total}

    def get_by_code(self, code_str):
        with self._lock:
            cur = self.conn.cursor()
            c = code_str.zfill(5)
            cur.execute("SELECT code, title, artist, filepath FROM songs WHERE code = ? LIMIT 1", (c,))
            return cur.fetchone()

    def close(self):
        self.conn.close()


