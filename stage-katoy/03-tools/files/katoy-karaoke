            f"<option value='1'{' selected' if mr=='1' else ''}>Reverb</option>")

        sm = str(cfg.get("SCORING_MODE", "real"))
        page = page.replace("__SCORING_MODE_OPTS__",
            f"<option value='real'{' selected' if sm=='real' else ''}>Real (Microphone energy)</option>"
            f"<option value='fun'{' selected' if sm=='fun' else ''}>Fun (Random 88-100)</option>")

        od = str(cfg.get("OUTPUT_DEVICE", "auto")).lower()
        page = page.replace("__OUTPUT_DEVICE_OPTS__",
            f"<option value='auto'{' selected' if od=='auto' else ''}>Auto (HDMI preferred)</option>"
            f"<option value='hdmi'{' selected' if od=='hdmi' else ''}>HDMI</option>"
            f"<option value='3.5mm'{' selected' if od in ('3.5mm', 'analog', 'headphones') else ''}>3.5mm Headphone Jack</option>")

        self.send_html(page)

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        app = self.app_instance
        hotspot_active = is_hotspot_active() or bool(app and getattr(app, "net_ap", False))

        client_ip = self.client_address[0] if hasattr(self, "client_address") and self.client_address else ""
        is_ap_client = client_ip.startswith("10.0.0.") or client_ip.startswith("10.42.0.") or client_ip == "127.0.0.1" or (hotspot_active and not client_ip)

        # Probe paths redirect to captive portal
        probe_paths = (
            "/generate_204",
            "/gen_204",
            "/hotspot-detect.html",
            "/library/test/success.html",
            "/connecttest.txt",
            "/ncsi.txt",
            "/redirect",
            "/success.txt",
            "/canonical.html",
            "/check_network_status.txt",
            "/mobile/status.php",
            "/kindle-wifi/wifiredirect.html",
            "/kindle-wifi/wifistatus.html",
        )
        if hotspot_active or is_ap_client:
            port = app.config.get("REMOTE_PORT", "8080") if (app and hasattr(app, "config")) else "8080"
            # When request is from AP subnet, always direct to AP gateway 10.0.0.1
            if is_ap_client or not (app and hasattr(app, "net_ip") and app.net_ip and not app.net_ip.startswith("127.")):
                ip = "10.0.0.1"
            else:
                ip = app.net_ip
            portal_url = f"http://{ip}:{port}/"

            if path in probe_paths:
                self.send_redirect(portal_url, 302)
                return

        # REMOTE_PIN gates the player API.
        # First-time Wi-Fi setup (/wifi, /setup, status polling) stays open while in hotspot mode.
        # Furthermore, requests originating from the AP subnet (10.0.0.0/24) or local loopback
        # are exempt from REMOTE_PIN so AP users who just joined the Wi-Fi immediately get full remote
        # and setup access without needing an unshared PIN.

        # /settings and API routes: accessible without PIN by AP clients (10.0.0.0/24)
        if self.pin and not is_ap_client and params.get("pin", [""])[0] != self.pin:
            self.send_json({"error": "Unauthorized / Invalid PIN"}, 401)
            return

        if path == "/":
            self.send_html(REMOTE_HTML)
        elif path == "/api/search":
            q = params.get("q", [""])[0]
            offset = 0
            limit = 20
            if "offset" in params:
                try:
                    offset = int(params["offset"][0])
                except ValueError:
                    self.send_json({"error": "Invalid offset parameter"}, 400)
                    return
            if "limit" in params:
                try:
                    limit = int(params["limit"][0])
                except ValueError:
                    self.send_json({"error": "Invalid limit parameter"}, 400)
                    return
            offset = max(0, offset)
            limit = max(1, min(limit, 200))
            self.send_json(app.db.search(q, offset=offset, limit=limit) if (app and app.db) else {"songs": [], "total": 0})
        elif path == "/api/reserve":
            code = params.get("code", [""])[0].strip()
            singer = params.get("singer", [""])[0].strip()
            song = app.db.get_by_code(code) if (app and app.db and code) else None
            if song and self.bridge_signals:
                entry = (song[0], song[1], song[2], song[3], singer)
                self.bridge_signals.reserve_song.emit(entry)
                self.send_json({"status": "ok", "msg": f"Reserved: [{song[0]}] {song[1]}"})
            else:
                self.send_json({"error": "Unknown song code"}, 404)
        elif path == "/api/play":
            code = params.get("code", [""])[0].strip()
            singer = params.get("singer", [""])[0].strip()
            song = app.db.get_by_code(code) if (app and app.db and code) else None
            if song and self.bridge_signals:
                entry = (song[0], song[1], song[2], song[3], singer)
                self.bridge_signals.play_song.emit(entry)
                self.send_json({"status": "ok", "msg": f"Playing now: [{song[0]}] {song[1]}"})
            else:
                self.send_json({"error": "Unknown song code"}, 404)
        elif path == "/api/queue/remove":
            idx = params.get("index", [""])[0].strip()
            if idx.isdigit() and self.bridge_signals:
                self.bridge_signals.remove_queue.emit(int(idx))
                self.send_json({"status": "ok", "msg": "Removed from queue"})
            else:
                self.send_json({"error": "Invalid queue index"}, 400)
        elif path == "/api/queue/clear":
            if self.bridge_signals:
                self.bridge_signals.clear_queue.emit()
            self.send_json({"status": "ok", "msg": "Queue cleared"})
        elif path == "/api/rescan":
            if self.bridge_signals:
                self.bridge_signals.rescan_library.emit()
            self.send_json({"status": "ok", "msg": "Library rescan started"})
        elif path == "/api/queue":
            self.send_json([[s[0], s[1], s[2], s[4] if len(s) > 4 else ""] for s in list(app.reservation_queue)] if app else [])
        elif path == "/api/state":
            cur = app.current_song if app else None
            self.send_json({
                "playing": bool(app and app.is_playing),
                "paused": bool(app and app.is_paused),
                "code": cur[0] if cur else "",
                "title": cur[1] if cur else "",
                "artist": cur[2] if cur else "",
                "key": app.pitch_key if app else 0,
                "tempo": int(round(app.tempo_multiplier * 100)) if app else 100,
                "queue": [[s[0], s[1], s[2], s[4] if len(s) > 4 else ""] for s in list(app.reservation_queue)] if app else [],
            })
        elif path in ("/api/key", "/api/tempo"):
            try:
                d = int(params.get("delta", ["0"])[0]) if path == "/api/key" else float(params.get("delta", ["0"])[0])
            except ValueError:
                self.send_json({"error": "Bad delta"}, 400)
                return
            if self.bridge_signals:
                (self.bridge_signals.adjust_key if path == "/api/key" else self.bridge_signals.adjust_tempo).emit(d)
            self.send_json({"status": "ok"})
        elif path == "/api/skip":
            if self.bridge_signals:
                self.bridge_signals.skip_song.emit()
            self.send_json({"status": "ok"})
        elif path == "/api/pause":
            if self.bridge_signals:
                self.bridge_signals.toggle_pause.emit()
            self.send_json({"status": "ok"})
        elif path == "/settings":
            if any(k in params for k in ("HOTSPOT_SSID", "HOTSPOT_PASSWORD", "REMOTE_PIN", "MIC_VOLUME", "MUSIC_VOLUME", "MIC_ENABLED", "MIC_REVERB", "SCORING_MODE", "LYRIC_OFFSET", "OUTPUT_DEVICE")):
                self._apply_settings_update(params)
            else:
                self._serve_settings_page()
        else:
            if hotspot_active or is_ap_client:
                port = app.config.get("REMOTE_PORT", "8080") if (app and hasattr(app, "config")) else "8080"
                if is_ap_client or not (app and hasattr(app, "net_ip") and app.net_ip and not app.net_ip.startswith("127.")):
                    ip = "10.0.0.1"
                else:
                    ip = app.net_ip
                self.send_redirect(f"http://{ip}:{port}/", 302)
            else:
                self.send_json({"error": "Not Found"}, 404)


class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True


class RemoteWebServer(QThread):
    def __init__(self, port, pin, app_instance, bridge_signals):
        super().__init__()
        self.port = port
        self.pin = pin
        self.app_instance = app_instance
        self.bridge_signals = bridge_signals
        self.httpd = None

    def run(self):
        handler_class = RemoteRequestHandler
        handler_class.app_instance = self.app_instance
        handler_class.bridge_signals = self.bridge_signals
        handler_class.pin = self.pin

        # Bind every interface: at boot we usually start before Wi-Fi has an address (and the setup
        # hotspot appears later still), so binding to the IP present *now* would strand the phone remote.
        bind_ip = "0.0.0.0"
        try:
            self.httpd = ThreadedHTTPServer((bind_ip, self.port), handler_class)
            print(f"Phone remote web server listening on {bind_ip}:{self.port}")
            self.httpd.serve_forever()
        except Exception as e:
            print(f"RemoteWebServer error: {e}")

    def stop(self):
        if self.httpd:
            try:
                self.httpd.shutdown()
                self.httpd.server_close()
            except Exception:
                pass


class MicrophoneChainManager:
    """Manages PipeWire/PulseAudio mic-to-output loopback, volume, mute, and sink selection."""

    def __init__(self, config):
        self.config = config
        self.loopback_module_id = None
        self.is_muted = False
        self.mic_volume = int(config.get("MIC_VOLUME", "80"))
        self.music_volume = int(config.get("MUSIC_VOLUME", "100"))
        self.reverb_enabled = (config.get("MIC_REVERB", "1") == "1")
        self.mic_enabled = (config.get("MIC_ENABLED", "1") == "1")
        self.output_device = config.get("OUTPUT_DEVICE", "auto")
        self.current_sink = None
        self._sink_warned = False

    def select_output_sink(self, target_device=None):
        """Resolves target sink (preferring HDMI under 'auto'/'hdmi' or analog under '3.5mm') and configures it."""
        if target_device is not None:
            self.output_device = target_device
        if not shutil.which("pactl"):
            return None

        dev = self.output_device.strip().lower()
        try:
            res = subprocess.run(["pactl", "list", "short", "sinks"], capture_output=True, text=True, timeout=3)
            if res.returncode != 0:
                return None
            sinks = []
            for line in res.stdout.splitlines():
                parts = line.strip().split()
                if len(parts) >= 2:
                    sinks.append(parts[1])
        except Exception:
            return None

        if not sinks:
            if not self._sink_warned:
                print("Warning: No audio sinks found via pactl list short sinks.")
                self._sink_warned = True
            return None

        chosen_sink = None
        if dev in ("auto", "hdmi"):
            # Prefer sink with hdmi, vc4, bcm2835.*hdmi, displayport
            for s in sinks:
                sl = s.lower()
                if any(k in sl for k in ("hdmi", "vc4", "displayport")) or ("bcm2835" in sl and "hdmi" in sl):
                    chosen_sink = s
                    break
            if not chosen_sink and dev == "hdmi":
                if not self._sink_warned:
                    print("Warning: OUTPUT_DEVICE=hdmi requested but no HDMI sink found; keeping current sink.")
                    self._sink_warned = True
        elif dev in ("3.5mm", "analog", "headphones", "headphone"):
            for s in sinks:
                sl = s.lower()
                if any(k in sl for k in ("analog", "headphones", "headphone")) or ("bcm2835" in sl and "analog" in sl):
                    chosen_sink = s
                    break
        else:
            # Explicit sink name
            for s in sinks:
                if s == self.output_device or s.lower() == dev:
                    chosen_sink = s
                    break

        if chosen_sink:
            self.current_sink = chosen_sink
            try:
                subprocess.run(["pactl", "set-default-sink", chosen_sink], stderr=subprocess.DEVNULL)
                subprocess.run(["pactl", "set-sink-mute", chosen_sink, "0"], stderr=subprocess.DEVNULL)
                subprocess.run(["pactl", "set-sink-volume", chosen_sink, f"{self.music_volume}%"], stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"Error configuring sink {chosen_sink}: {e}")
            return chosen_sink

        # Fallback to current default sink
        sink_target = self.current_sink or "@DEFAULT_SINK@"
        try:
            subprocess.run(["pactl", "set-sink-mute", sink_target, "0"], stderr=subprocess.DEVNULL)
            subprocess.run(["pactl", "set-sink-volume", sink_target, f"{self.music_volume}%"], stderr=subprocess.DEVNULL)
        except Exception:
            pass
        return None

    def apply_settings(self):
        if not self.mic_enabled:
            self.stop_loopback()
            return

        if shutil.which("pactl"):
            try:
                if self.loopback_module_id is None:
                    res = subprocess.run(
                        ["pactl", "load-module", "module-loopback", "latency_msec=20"],
                        capture_output=True, text=True
                    )
                    if res.returncode == 0 and res.stdout.strip().isdigit():
                        self.loopback_module_id = res.stdout.strip()

                val = 0 if self.is_muted else self.mic_volume
                subprocess.run(["pactl", "set-source-volume", "@DEFAULT_SOURCE@", f"{val}%"], stderr=subprocess.DEVNULL)
                subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "1" if self.is_muted else "0"], stderr=subprocess.DEVNULL)
            except Exception as e:
                print(f"MicrophoneChainManager pactl error: {e}")

    def set_mic_volume(self, volume):
        self.mic_volume = max(0, min(100, volume))
        self.apply_settings()

    def set_music_volume(self, volume):
        self.music_volume = max(0, min(100, volume))
        if shutil.which("pactl"):
            sink_target = self.current_sink or "@DEFAULT_SINK@"
            try:
                subprocess.run(["pactl", "set-sink-volume", sink_target, f"{self.music_volume}%"], stderr=subprocess.DEVNULL)
            except Exception:
                pass

    def toggle_mute(self):
        self.is_muted = not self.is_muted
        self.apply_settings()
        return self.is_muted

    def set_output_device(self, device_name):
        self.output_device = device_name
        self.select_output_sink(device_name)

    def stop_loopback(self):
        if self.loopback_module_id and shutil.which("pactl"):
            try:
                subprocess.run(["pactl", "unload-module", self.loopback_module_id], stderr=subprocess.DEVNULL)
            except Exception:
                pass
            self.loopback_module_id = None


