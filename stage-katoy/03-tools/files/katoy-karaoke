def get_local_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    ip = ''
    try:
        s.connect(('10.255.255.255', 1))
        ip = s.getsockname()[0]
    except Exception:
        ip = ''
    finally:
        s.close()
    if ip and not ip.startswith('127.'):
        return ip
    # No default route (e.g. we ARE the setup hotspot): use any IPv4 address the box has.
    try:
        out = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=2).stdout.split()
        for cand in out:
            if cand.count(".") == 3 and not cand.startswith("127."):
                return cand
    except Exception:
        pass
    return '127.0.0.1'


def parse_systemd_analyze_output(output_str):
    """Pure helper function parsing systemd-analyze output."""
    if not output_str:
        return None
    # Example format: Startup finished in 4.120s (kernel) + 17.340s (userspace) = 21.460s
    m = re.search(r"Startup finished in\s+(.*?)\s*=\s*([\d\.]+[s|ms]+)", output_str)
    if m:
        breakdown = m.group(1).strip()
        total = m.group(2).strip()
        return f"Boot time: {total} ({breakdown}) | target ~25s"
    return None


def get_systemd_boot_time():
    """Reads systemd-analyze output to retrieve real boot duration."""
    if shutil.which("systemd-analyze"):
        try:
            res = subprocess.run(["systemd-analyze"], capture_output=True, text=True)
            parsed = parse_systemd_analyze_output(res.stdout)
            if parsed:
                return parsed
        except Exception:
            pass
    return "Boot time: unmeasured (target ~25s)"


def parse_nmcli_wifi_list(output_str):
    """Pure helper function parsing nmcli wifi list output into structured SSIDs."""
    if not output_str:
        return []
    ssids = []
    seen = set()
    for line in output_str.strip().splitlines():
        parts = line.split(":")
        if parts and parts[0].strip():
            ssid = parts[0].strip()
            if ssid not in seen and ssid != "--":
                seen.add(ssid)
                ssids.append(ssid)
    return ssids


def parse_nmcli_general_state(output_str):
    """Pure helper function parsing nmcli general state output."""
    if not output_str:
        return "unknown"
    clean = output_str.strip().lower()
    if "connected (local only)" in clean or "connected (site only)" in clean:
        return "limited"
    elif "disconnected" in clean or "asleep" in clean:
        return "disconnected"
    elif "connected" in clean:
        return "connected"
    return clean


def check_and_trigger_wifi_hotspot(config):
    """Raises the KaraOkePi AP services (katoy-ap.service, katoy-ap-dhcp.service) if not already active."""
    ssid = config.get("HOTSPOT_SSID", "KaraOkePi")
    if is_hotspot_active():
        return True, ssid
    try:
        res = subprocess.run(["systemctl", "start", "katoy-ap.service", "katoy-ap-dhcp.service"],
                             capture_output=True, text=True, timeout=8)
        if res.returncode != 0:
            print(f"Warning: systemctl start katoy-ap katoy-ap-dhcp returned {res.returncode}: {res.stderr.strip()}")
        if is_hotspot_active():
            return True, ssid
    except Exception as e:
        print(f"Error starting katoy-ap services: {e}")
    return False, ""


def wifi_qr_payload(ssid, password):
    """Standard 'join this Wi-Fi' QR payload (phone cameras connect directly)."""
    def esc(s):
        return re.sub(r'([\\;,:"])', r'\\\1', s)
    return f"WIFI:T:WPA;S:{esc(ssid)};P:{esc(password)};;"


def get_nm_state():
    if not shutil.which("nmcli"):
        return "absent"
    try:
        res = subprocess.run(["nmcli", "-t", "-g", "STATE", "general"], capture_output=True, text=True, timeout=5)
        return parse_nmcli_general_state(res.stdout)
    except Exception:
        return "unknown"


def is_hotspot_active():
    """True while hostapd/katoy-ap.service, an AP interface, or NetworkManager's AP hotspot is active with 10.0.0.0/24 subnet."""
    for svc in ("katoy-ap.service", "hostapd.service"):
        try:
            svc_res = subprocess.run(["systemctl", "is-active", "--quiet", svc], timeout=3)
            if svc_res.returncode == 0:
                return True
        except Exception:
            pass

    try:
        iw_res = subprocess.run(["iw", "dev"], capture_output=True, text=True, timeout=3)
        if iw_res.returncode == 0 and "type AP" in iw_res.stdout:
            return True
    except Exception:
        pass
    try:
        iwc_res = subprocess.run(["iwconfig"], capture_output=True, text=True, timeout=3)
        if iwc_res.returncode == 0 and "Mode:Master" in iwc_res.stdout:
            return True
    except Exception:
        pass

    try:
        ip_res = subprocess.run(["ip", "-o", "-4", "addr", "show"], capture_output=True, text=True, timeout=3)
        if ip_res.returncode == 0 and (" 10.0.0." in ip_res.stdout or ("10.0.0.1" in ip_res.stdout and "/24" in ip_res.stdout)):
            return True
    except Exception:
        pass

    if shutil.which("nmcli"):
        try:
            res = subprocess.run(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"],
                                 capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                active_names = {ln.strip() for ln in res.stdout.splitlines()}
                if bool({"KaraOkePi-AP", "KaraokePi-AP", "Hotspot"} & active_names):
                    return True
        except Exception:
            pass

    return False


class NetworkWatcher(QThread):
    """Tracks IP / hotspot state off the UI thread.

    In HOTSPOT_MODE=always (default), the KaraOkePi AP is raised on boot and permanently broadcasts
    the control network so phones can connect immediately.
    In HOTSPOT_MODE=fallback, the AP is only raised if the network has been continuously down for HOTSPOT_GRACE seconds.
    The watcher keeps refreshing IP and AP state so the idle-screen QR is never stale.
    """

    changed = pyqtSignal(str, bool, str)  # ip, hotspot_active, hotspot_ssid

    def __init__(self, config, poll_sec=3.0):
        super().__init__()
        self.config = config
        self.mode = config.get("HOTSPOT_MODE", "always").lower()
        try:
            self.grace = float(config.get("HOTSPOT_GRACE", "45") or 45)
        except ValueError:
            self.grace = 45.0
        self.poll = poll_sec
        self._stop_flag = False

    def stop(self):
        self._stop_flag = True

    def _sleep(self, secs):
        end = time.monotonic() + secs
        while not self._stop_flag and time.monotonic() < end:
            time.sleep(0.2)

    def run(self):
        ssid = self.config.get("HOTSPOT_SSID", "KaraOkePi")
        offline_since = None
        last_attempt = -1e9
        last = None

        if self.mode == "always":
            # Give NetworkManager a short moment to finish initial startup
            self._sleep(2.0)
            if not self._stop_flag:
                check_and_trigger_wifi_hotspot(self.config)

        while not self._stop_flag:
            state = get_nm_state()
            ap = is_hotspot_active() if state != "absent" else False
            now = time.monotonic()

            if self.mode == "always":
                # Ensure AP remains active in always-on mode
                if not ap and now - last_attempt > 15:
                    last_attempt = now
                    check_and_trigger_wifi_hotspot(self.config)
                    ap = is_hotspot_active()
            else:
                # Fallback mode: AP only when offline past grace period
                if ap or state not in ("disconnected", "unknown"):
                    offline_since = None
                else:
                    if offline_since is None:
                        offline_since = now
                    if now - offline_since >= self.grace and now - last_attempt > 60:
                        last_attempt = now
                        check_and_trigger_wifi_hotspot(self.config)
                        ap = is_hotspot_active()

            # When AP is active, AP clients connect to 10.0.0.1;
            # get_local_ip() will return either 10.0.0.1 or the local LAN/STA IP.
            # If AP is active and IP returned is 127.0.0.1, fall back to 10.0.0.1.
            ip = get_local_ip()
            if ap and (not ip or ip.startswith("127.")):
                ip = "10.0.0.1"

            info = (ip, ap, ssid if ap else "")
            if info != last:
                last = info
                self.changed.emit(*info)
            self._sleep(self.poll)


class FuncWorker(QThread):
    """Run a blocking function off the UI thread and emit its result."""
    result = pyqtSignal(object)

    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def run(self):
        try:
            self.result.emit(self.fn())
        except Exception as e:
            self.result.emit(f"unavailable ({e})")


def generate_qr_matrix(text):
    try:
        import qrcode
        qr = qrcode.QRCode(version=1, box_size=1, border=0)
        qr.add_data(text)
        qr.make(fit=True)
        return qr.get_matrix()
    except Exception:
        size = 21
        matrix = [[False]*size for _ in range(size)]
        def add_finder(rx, ry):
            for r in range(7):
                for c in range(7):
                    if r in (0, 6) or c in (0, 6) or (2 <= r <= 4 and 2 <= c <= 4):
                        matrix[rx + r][ry + c] = True

        add_finder(0, 0)
        add_finder(0, size - 7)
        add_finder(size - 7, 0)

        for i in range(8, size - 8):
            if i % 2 == 0:
                matrix[6][i] = True
                matrix[i][6] = True

        h = hash(text) & 0xFFFFFFFF
        for r in range(size):
            for c in range(size):
                if not matrix[r][c] and not (r < 9 and c < 9) and not (r < 9 and c >= size - 8) and not (r >= size - 8 and c < 9):
                    if ((r * 7 + c * 13 + h) % 3) == 0:
                        matrix[r][c] = True

        return matrix


