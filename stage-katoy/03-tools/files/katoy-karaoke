        self.kiosk = config.get("KIOSK", "0") == "1"
        self.songs_dir = None
        self.db = None
        self.soundfont = None
        self.backgrounds = []
        self.bg_index = 0
        self.current_song = None
        self.reservation_queue = []  # List of tuples: (code, title, artist, filepath)
        self.pitch_key = 0  # -6 to +6
        self.tempo_multiplier = 1.0  # 0.5 to 1.5
        self.persistent_synth = None
        self.fluid_proc = None
        self.playback_start_time = 0.0
        self.playback_paused_at = 0.0
        self.is_paused = False
        self.is_playing = False
        self.lyrics_lines = []
        self.song_duration = 0.0
        self.mic_energy_samples = []

        self._grad_cache = None
        self._cover_src = None
        self._cover_cache = None
        self._lyric_idx = -2
        self.net_ip = ""
        self.net_ap = False
        self.net_ssid = ""
        self.boot_info = ""
        self.song_count = 0
        self.indexer_worker = None
        self.net_watcher = None
        self.remote_server = None
        self._audio_ready = False
        self._audio_tries = 0

        # Cheap object; the pactl calls happen later in _late_init().
        # (Must exist before init_ui(): the settings page reads its values.)
        self.mic_manager = MicrophoneChainManager(self.config)

        self.init_ui()

        self.poll_timer = QTimer(self)
        self.poll_timer.timeout.connect(self.check_usb_and_media)

        self.play_timer = QTimer(self)
        self.play_timer.setInterval(50)  # 20 fps: smooth karaoke wipe, still light on a Pi 3B
        self.play_timer.timeout.connect(self.update_playback_ui)

        self.bg_timer = QTimer(self)
        self.bg_timer.setInterval(15000)
        self.bg_timer.timeout.connect(self.rotate_background)

        self.score_timer = QTimer(self)
        self.score_timer.setSingleShot(True)
        self.score_timer.timeout.connect(self.hide_score_banner_and_next)

        self.controls_timer = QTimer(self)
        self.controls_timer.setSingleShot(True)
        self.controls_timer.timeout.connect(self.hide_controls)

        self.remote_signals = RemoteBridgeSignals()
        self.remote_signals.reserve_song.connect(self.on_remote_reserve_song)
        self.remote_signals.adjust_key.connect(self.adjust_key)
        self.remote_signals.adjust_tempo.connect(self.adjust_tempo)
        self.remote_signals.skip_song.connect(self.play_next_reserved_song)
        self.remote_signals.toggle_pause.connect(self.toggle_play_pause)

        QApplication.instance().installEventFilter(self)

        # Show the first frame immediately; everything slow happens after the event loop starts.
        QTimer.singleShot(0, self._late_init)

    # ── startup (deferred) ──────────────────────────────────────────────────────
    def _late_init(self):
        if self.config.get("REMOTE_ENABLED", "1") == "1":
            try:
                r_port = int(self.config.get("REMOTE_PORT", "8080"))
                self.remote_server = RemoteWebServer(r_port, self.config.get("REMOTE_PIN", ""), self, self.remote_signals)
                self.remote_server.start()
            except Exception as e:
                print(f"Remote server failed to start: {e}")

        self.net_watcher = NetworkWatcher(self.config)
        self.net_watcher.changed.connect(self.on_network_changed)
        self.net_watcher.start()

        self.check_usb_and_media()
        self.poll_timer.start(2000)

        # PipeWire starts in parallel with us at boot; retry until it answers.
        self._try_audio_setup()

        # systemd-analyze only has a number once boot has finished, and it is slow: ask later, off-thread.
        QTimer.singleShot(25000, self._measure_boot_time)

    def _try_audio_setup(self):
        if self._audio_ready:
            return
        self._audio_tries += 1
        ok = True
        if shutil.which("pactl"):
            try:
                ok = subprocess.run(["pactl", "info"], capture_output=True, timeout=3).returncode == 0
            except Exception:
                ok = False
        if ok:
            self.mic_manager.apply_settings()
            self.mic_manager.set_music_volume(self.mic_manager.music_volume)
            self._audio_ready = True
        elif self._audio_tries < 40:
            QTimer.singleShot(1500, self._try_audio_setup)

    def _measure_boot_time(self):
        self._boot_worker = FuncWorker(get_systemd_boot_time)
        self._boot_worker.result.connect(self._on_boot_time)
        self._boot_worker.start()

    def _on_boot_time(self, text):
