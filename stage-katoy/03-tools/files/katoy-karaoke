    def check_usb_and_media(self):
        conf_dir = self.config.get("SONGS_DIR", "auto")

        if conf_dir == "auto":
            usb_dir = detect_usb_songs_dir()
        else:
            p = Path(conf_dir)
            usb_dir = p if p.exists() else None

        if not usb_dir:
            if self.songs_dir is not None:
                self.stop_playback()
                self.songs_dir = None
                if self.db:
                    self.db.close()
                    self.db = None
            self.stack.setCurrentWidget(self.no_usb_page)
            return

        if self.songs_dir != usb_dir:
            self.songs_dir = usb_dir
            if self.db:
                self.db.close()
                self.db = None
            self.start_async_indexing(force=False)

    def start_async_indexing(self, force=False):
        if not self.songs_dir:
            return

        self.status_lbl.setText("Indexing songs in background...")
        self.index_progress_bar.setValue(0)
        self.index_progress_bar.show()

        self.indexer_worker = SongIndexerWorker(self.songs_dir, self.config, force=force)
        self.indexer_worker.progress.connect(self.on_indexing_progress)
        self.indexer_worker.finished.connect(self.on_indexing_finished)
        self.indexer_worker.start()

    def on_indexing_progress(self, current, total):
        pct = int((current / total) * 100) if total > 0 else 0
        self.index_progress_bar.setValue(pct)
        self.status_lbl.setText(f"Indexing songs: {current}/{total}...")

    def on_indexing_finished(self, count, soundfont, backgrounds, read_only_msg):
        self.index_progress_bar.hide()
        db_path = (self.songs_dir / ".katoy-karaoke.db") if self.songs_dir.is_dir() else (self.songs_dir.parent / ".katoy-karaoke.db")
        if read_only_msg:
            safe_name = re.sub(r'[^a-zA-Z0-9_-]', '_', self.songs_dir.name)
            db_path = Path("/tmp/katoy_karaoke") / f".katoy-karaoke-{safe_name}.db"

        try:
            self.db = SongDatabase(db_path)
        except Exception as e:
            print(f"Failed to connect to index DB: {e}")

        self.soundfont = soundfont
        self.backgrounds = backgrounds
        self.update_background_image()

        self.status_lbl.setText(f"Loaded {count} songs from {self.songs_dir.name}{read_only_msg}")
        self.filter_library()

        if self.stack.currentWidget() == self.no_usb_page:
            self.stack.setCurrentWidget(self.library_page)

    def filter_library(self):
        if not self.db:
            return
        query = self.search_input.text().strip()
        rows = self.db.search(query)

        self.table.setRowCount(len(rows))
        for row_idx, (code, title, artist, filepath) in enumerate(rows):
            item_code = QTableWidgetItem(code)
            item_title = QTableWidgetItem(title)
            item_artist = QTableWidgetItem(artist)

            item_code.setData(Qt.ItemDataRole.UserRole, filepath)

            self.table.setItem(row_idx, 0, item_code)
            self.table.setItem(row_idx, 1, item_title)
            self.table.setItem(row_idx, 2, item_artist)

        if len(rows) > 0:
            self.table.selectRow(0)

    def on_rescan_pressed(self):
        if self.songs_dir:
            self.start_async_indexing(force=True)

    def reserve_selected_song(self):
        curr_row = self.table.currentRow()
        if curr_row < 0:
            return
        code = self.table.item(curr_row, 0).text()
        title = self.table.item(curr_row, 1).text()
        artist = self.table.item(curr_row, 2).text()
        filepath = self.table.item(curr_row, 0).data(Qt.ItemDataRole.UserRole)

        song_tuple = (code, title, artist, filepath)
        self.reservation_queue.append(song_tuple)
        self.update_queue_ui()
        self.status_lbl.setText(f"Reserved: [{code}] {title}")

    def update_queue_ui(self):
        self.queue_list.clear()
        for idx, (code, title, artist, _) in enumerate(self.reservation_queue, 1):
            self.queue_list.addItem(f"{idx}. [{code}] {title} - {artist}")

        if self.reservation_queue:
            next_code, next_title, next_artist, _ = self.reservation_queue[0]
            self.next_up_lbl.setText(f"NEXT UP: [{next_code}] {next_title} - {next_artist}")
        else:
            self.next_up_lbl.setText("NEXT UP: None (Select & press R to reserve)")

    def clear_reservation_queue(self):
        self.reservation_queue.clear()
        self.update_queue_ui()
        self.status_lbl.setText("Reservation queue cleared.")

    def play_next_reserved_song(self):
        if self.reservation_queue:
            song_tuple = self.reservation_queue.pop(0)
            self.update_queue_ui()
            code, title, artist, filepath = song_tuple
            self.start_playback(code, title, artist, filepath)
        else:
            self.stop_playback()

    def adjust_key(self, delta):
        self.pitch_key = max(-6, min(6, self.pitch_key + delta))
        self.key_lbl.setText(f"KEY: {self.pitch_key:+d}")
        self.status_lbl.setText(f"Key Transpose set to: {self.pitch_key:+d}")
        if self.is_playing and self.current_song:
            code, title, artist, filepath = self.current_song
            self.start_playback(code, title, artist, filepath)

    def adjust_tempo(self, delta):
        self.tempo_multiplier = max(0.5, min(1.5, round(self.tempo_multiplier + delta, 2)))
        tempo_pct = int(round(self.tempo_multiplier * 100))
        self.tempo_lbl.setText(f"TEMPO: {tempo_pct}%")
        self.status_lbl.setText(f"Tempo set to: {tempo_pct}%")
        if self.is_playing and self.current_song:
            code, title, artist, filepath = self.current_song
            self.start_playback(code, title, artist, filepath)

    def play_selected_or_first(self):
        query = self.search_input.text().strip()
        if query and self.db:
            match = self.db.get_by_code(query)
            if match:
                code, title, artist, filepath = match
                self.start_playback(code, title, artist, filepath)
                return

        curr_row = self.table.currentRow()
        if curr_row >= 0:
            self.play_selected_song()

    def play_selected_song(self):
        curr_row = self.table.currentRow()
        if curr_row < 0:
            return
        code = self.table.item(curr_row, 0).text()
        title = self.table.item(curr_row, 1).text()
        artist = self.table.item(curr_row, 2).text()
        filepath = self.table.item(curr_row, 0).data(Qt.ItemDataRole.UserRole)
        self.start_playback(code, title, artist, filepath)

    def start_playback(self, code, title, artist, filepath):
        self.stop_playback()

        if not self.soundfont:
            QMessageBox.warning(self, "SoundFont Missing",
                                "No SoundFont (.sf2) found on USB drive or system.\n"
                                "Please place a SoundFont file (.sf2) on your USB drive.")
            return

        fp = Path(filepath)
        if not fp.exists():
            QMessageBox.warning(self, "File Not Found", f"Song file missing:\n{filepath}")
            return

        self.current_song = (code, title, artist, filepath)
        self.p_code_lbl.setText(code)
        self.p_title_lbl.setText(title)
        self.p_artist_lbl.setText(artist)
        self.key_lbl.setText(f"KEY: {self.pitch_key:+d}")
        tempo_pct = int(round(self.tempo_multiplier * 100))
        self.tempo_lbl.setText(f"TEMPO: {tempo_pct}%")
        self.score_banner.hide()

        lines, duration, m_title, m_artist = extract_midi_lyrics_and_duration(filepath)
        if self.tempo_multiplier > 0:
            duration = duration / self.tempo_multiplier
            for line in lines:
                line['start_sec'] = line['start_sec'] / self.tempo_multiplier
                for syl in line['syllables']:
                    syl['sec'] = syl['sec'] / self.tempo_multiplier

        self.lyrics_lines = lines
        self.song_duration = duration if duration > 0 else (180.0 / self.tempo_multiplier)

        if m_title and title == fp.stem:
            self.p_title_lbl.setText(m_title)
        if m_artist and artist == "Unknown Artist":
            self.p_artist_lbl.setText(m_artist)

        play_file = fp
        if self.pitch_key != 0 or abs(self.tempo_multiplier - 1.0) >= 1e-4:
            tmp_midi = Path("/tmp/katoy_processed.mid")
            play_file = process_midi_file(fp, tmp_midi, self.pitch_key, self.tempo_multiplier)

        audio_driver = self.config.get("AUDIO_DRIVER", "pulseaudio")

        started_persistent = False
        if not self.persistent_synth or self.persistent_synth.soundfont_path != self.soundfont:
            if self.persistent_synth:
                self.persistent_synth.cleanup()
            self.persistent_synth = PersistentFluidSynth(self.soundfont, audio_driver=audio_driver)

        if self.persistent_synth and self.persistent_synth.is_initialized:
            if self.persistent_synth.load_song(play_file):
                if self.persistent_synth.play():
                    started_persistent = True

        if not started_persistent:
            cmd = ["fluidsynth", "-i", "-a", audio_driver, "-g", "0.8", str(self.soundfont), str(play_file)]
            try:
                self.fluid_proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception as e:
                QMessageBox.critical(self, "FluidSynth Error", f"Failed to start FluidSynth:\n{e}")
                return

        self.playback_start_time = time.time()
        self.is_playing = True
        self.is_paused = False
        self.pause_btn.setText("⏸ Pause")

        self.update_background_image()
        self.bg_timer.start()
        self.play_timer.start()

        self.stack.setCurrentWidget(self.player_page)

    def toggle_play_pause(self):
        if not self.is_playing:
            return

        if self.is_paused:
            if self.persistent_synth and self.persistent_synth.is_initialized and not self.fluid_proc:
                self.persistent_synth.resume()
            elif self.fluid_proc:
                try:
                    self.fluid_proc.send_signal(18)  # SIGCONT
                except Exception:
                    pass
            self.playback_start_time += (time.time() - self.playback_paused_at)
            self.is_paused = False
            self.pause_btn.setText("⏸ Pause")
        else:
            if self.persistent_synth and self.persistent_synth.is_initialized and not self.fluid_proc:
                self.persistent_synth.pause()
            elif self.fluid_proc:
                try:
                    self.fluid_proc.send_signal(19)  # SIGSTOP
                except Exception:
                    pass
            self.playback_paused_at = time.time()
            self.is_paused = True
            self.pause_btn.setText("▶ Resume")

    def show_pinoy_score_banner(self):
        """Displays videoke end-of-song score banner (real VAD or fun random with praise text)."""
        mode = self.config.get("SCORING_MODE", "real").lower()
        if mode == "real" and self.mic_energy_samples:
            score = calculate_real_score(self.mic_energy_samples, len(self.lyrics_lines))
        else:
            score = random.randint(88, 100)

        praise = "👏 MAGALING!"
        for min_s, txt in PRAISE_TEXTS:
            if score >= min_s:
                praise = txt
                break

        self.score_banner.setText(f"SCORE: {score}\n\n{praise}")
        self.score_banner.show()
        self.score_timer.start(4000)

    def hide_score_banner_and_next(self):
        self.score_banner.hide()
        if self.reservation_queue:
            self.play_next_reserved_song()
        else:
            self.stop_playback()

    def stop_playback(self):
        self.play_timer.stop()
        self.bg_timer.stop()
        self.score_timer.stop()

        if self.persistent_synth:
            self.persistent_synth.stop()

        if self.fluid_proc:
            try:
                self.fluid_proc.terminate()
                self.fluid_proc.wait(timeout=1.0)
            except Exception:
                try:
                    self.fluid_proc.kill()
                except Exception:
                    pass
            self.fluid_proc = None

        self.is_playing = False
        self.is_paused = False
        self.current_song = None

        if self.stack.currentWidget() == self.player_page:
            self.stack.setCurrentWidget(self.library_page)
            self.search_input.setFocus()

    def update_playback_ui(self):
        if not self.is_playing:
            return

        using_persistent = (
            self.persistent_synth and
            self.persistent_synth.is_initialized and
            self.persistent_synth.player and
            not self.fluid_proc
        )

        if using_persistent:
            status = self.persistent_synth.get_status()
            if status == PersistentFluidSynth.FLUID_PLAYER_DONE and not self.is_paused:
                self.show_pinoy_score_banner()
                self.play_timer.stop()
                return
        elif self.fluid_proc and self.fluid_proc.poll() is not None and not self.is_paused:
            self.show_pinoy_score_banner()
            self.play_timer.stop()
            return

        if using_persistent:
            if self.is_paused:
                cur_tick = self.persistent_synth.saved_tick
            else:
                cur_tick = self.persistent_synth.get_current_tick()
            tot_ticks = self.persistent_synth.get_total_ticks()
            elapsed = calculate_elapsed_seconds(cur_tick, tot_ticks, self.song_duration)
        else:
            if self.is_paused:
                elapsed = self.playback_paused_at - self.playback_start_time
            else:
                elapsed = time.time() - self.playback_start_time

        elapsed = max(0.0, elapsed)
        dur = max(1.0, self.song_duration)

        m_el, s_el = divmod(int(elapsed), 60)
        m_du, s_du = divmod(int(dur), 60)
        self.time_lbl.setText(f"{m_el:02d}:{s_el:02d} / {m_du:02d}:{s_du:02d}")

        pct = int((elapsed / dur) * 100)
        self.progress_bar.setValue(min(100, pct))

        self.render_lyrics(elapsed)

    def render_lyrics(self, elapsed_sec):
        if not self.lyrics_lines:
            self.lyric_prev_lbl.setText("")
            self.lyric_curr_lbl.setText("♪ [Instrumental / No Lyrics] ♪")
            self.lyric_next_lbl.setText("")
            return

        curr_idx = -1
        for idx, line in enumerate(self.lyrics_lines):
            if elapsed_sec >= line['start_sec']:
                curr_idx = idx
            else:
                break

        if curr_idx == -1:
            self.lyric_prev_lbl.setText("")
            self.lyric_curr_lbl.setText("♪ ... ♪")
            self.lyric_next_lbl.setText(self.lyrics_lines[0]['text'] if len(self.lyrics_lines) > 0 else "")
            return

        line_data = self.lyrics_lines[curr_idx]
        prev_text = self.lyrics_lines[curr_idx - 1]['text'] if curr_idx > 0 else ""
        next_text = self.lyrics_lines[curr_idx + 1]['text'] if curr_idx + 1 < len(self.lyrics_lines) else ""

        highlighted_parts = []
        for syl in line_data['syllables']:
            txt = syl['text']
            if elapsed_sec >= syl['sec']:
                highlighted_parts.append(f"<span style='color: #00ffff;'>{txt}</span>")
            else:
                highlighted_parts.append(f"<span style='color: #ffffff;'>{txt}</span>")

        curr_html = "".join(highlighted_parts)

        self.lyric_prev_lbl.setText(prev_text)
        self.lyric_curr_lbl.setText(curr_html)
        self.lyric_next_lbl.setText(next_text)

    def rotate_background(self):
        if len(self.backgrounds) > 1:
            self.bg_index = (self.bg_index + 1) % len(self.backgrounds)
            self.update_background_image()

    def update_background_image(self):
        if self.backgrounds and self.backgrounds[self.bg_index].exists():
            pix = QPixmap(str(self.backgrounds[self.bg_index]))
            self.bg_label.setPixmap(pix)

    def on_escape_pressed(self):
        if self.stack.currentWidget() == self.player_page:
            self.stop_playback()
        elif self.stack.currentWidget() == self.library_page:
            self.close()

    def closeEvent(self, event):
        self.stop_playback()
        if self.db:
            self.db.close()
        event.accept()


def main():
    config = load_config()
    app = QApplication(sys.argv)
    app.setApplicationName("KatoyOS Pinoy Videoke Player")

    player = KaraokeApp(config)
    player.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
