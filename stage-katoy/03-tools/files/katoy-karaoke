class EqualizerWidget(QWidget):
    """Decorative animated equalizer. Animates only while visible (cheap, small area)."""

    def __init__(self, bars=20, parent=None):
        super().__init__(parent)
        self._bars = bars
        self._t = 0.0
        self._timer = QTimer(self)
        self._timer.setInterval(70)
        self._timer.timeout.connect(self._tick)
        self.setMinimumHeight(S(84))
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def showEvent(self, ev):
        self._timer.start()
        super().showEvent(ev)

    def hideEvent(self, ev):
        self._timer.stop()
        super().hideEvent(ev)

    def _tick(self):
        self._t += 0.11
        self.update()

    def paintEvent(self, ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setPen(Qt.PenStyle.NoPen)
        w, h = self.width(), self.height()
        n = self._bars
        gap = S(8)
        bw = max(2.0, (w - gap * (n - 1)) / n)
        for i in range(n):
            amp = 0.20 + 0.80 * abs(math.sin(self._t * (1.2 + 0.19 * (i % 7)) + i * 0.83))
            bh = max(float(S(8)), amp * h)
            f = i / max(1, n - 1)
            if f < 0.5:
                c = self._mix(COL_PINK, COL_VIOLET, f * 2)
            else:
                c = self._mix(COL_VIOLET, COL_CYAN, (f - 0.5) * 2)
            p.setBrush(c)
            p.drawRoundedRect(QRectF(i * (bw + gap), h - bh, bw, bh), bw / 2, bw / 2)

    @staticmethod
    def _mix(a, b, t):
        return QColor(int(a.red() + (b.red() - a.red()) * t),
                      int(a.green() + (b.green() - a.green()) * t),
                      int(a.blue() + (b.blue() - a.blue()) * t))


