        def slider_row(icon, name, desc, value, apply_fn):
            row = QHBoxLayout()
            row.setSpacing(S(22))
            ic = QLabel()
            ic.setPixmap(badge_pixmap(icon, S(60)))
            col = QVBoxLayout()
            col.setSpacing(0)
            n = QLabel(name)
            n.setFont(ui_font(25, QFont.Weight.ExtraBold))
            d = QLabel(desc)
            d.setFont(ui_font(17, QFont.Weight.Medium))
            d.setProperty("role", "muted")
            col.addWidget(n)
            col.addWidget(d)
            sl = QSlider(Qt.Orientation.Horizontal)
            sl.setRange(0, 100)
            sl.setSingleStep(5)
            sl.setPageStep(10)
            sl.setValue(int(value))
            sl.setFixedWidth(S(520))
            val = QLabel(f"{int(value)}%")
            val.setFont(ui_font(24, QFont.Weight.ExtraBold))
            val.setMinimumWidth(S(86))
            val.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)

            debounce = QTimer(self)
            debounce.setSingleShot(True)
            debounce.setInterval(180)  # don't spawn a pactl process on every slider tick
            debounce.timeout.connect(lambda: apply_fn(sl.value()))

            def changed(v):
                val.setText(f"{v}%")
                debounce.start()
            sl.valueChanged.connect(changed)
            row.addWidget(ic)
            row.addLayout(col, 1)
            row.addWidget(sl)
            row.addWidget(val)
            return row

