    def refresh_network_panel(self):
        ip, ap = self.net_ip, self.net_ap
        port = self.config.get("REMOTE_PORT", "8080")
        have_ip = bool(ip) and not ip.startswith("127.")
        if ap:
            ssid = self.net_ssid or self.config.get("HOTSPOT_SSID", "KatoyOS-Karaoke")
            pwd = self.config.get("HOTSPOT_PASSWORD", "katoyos123")
            host = ip if have_ip else "10.42.0.1"
            self.remote_title.setText("Connect to Wi-Fi")
            self.remote_sub.setText("No Wi-Fi yet. Use your phone to give this karaoke box internet access.")
            self.qr_a.set_qr(wifi_qr_payload(ssid, pwd), "1 · Join hotspot", 230)
            self.qr_a.show()
            self.qr_b.set_qr(f"http://{host}:{port}/wifi", "2 · Open setup", 230)
            self.remote_url_lbl.setText(f"http://{host}:{port}/wifi")
            self.ap_info_lbl.setText(f"Hotspot: {ssid}   ·   Password: {pwd}")
            self.ap_info_lbl.show()
        elif have_ip:
            self.remote_title.setText("Sing from your phone")
            self.remote_sub.setText("Scan the code to search, reserve songs and change key.")
            self.qr_a.hide()
            self.qr_b.set_qr(f"http://{ip}:{port}", "Scan to open remote", 300)
            self.remote_url_lbl.setText(f"http://{ip}:{port}")
            self.ap_info_lbl.hide()
        else:
            self.remote_title.setText("Waiting for network…")
            self.remote_sub.setText("Connecting to Wi-Fi. If nothing is saved, a setup hotspot will appear in a moment.")
            self.qr_a.hide()
            self.qr_b.img.clear()
            self.qr_b.cap.setText("")
            self.remote_url_lbl.setText("")
            self.ap_info_lbl.hide()

    def on_network_changed(self, ip, is_ap, ssid):
        self.net_ip, self.net_ap, self.net_ssid = ip, is_ap, ssid
        self.refresh_network_panel()
        if hasattr(self, "sys_remote_val"):
            self.sys_remote_val.setText(f"http://{ip}:{self.config.get('REMOTE_PORT', '8080')}" if ip and not ip.startswith("127.") else "offline")

