class RemoteRequestHandler(BaseHTTPRequestHandler):
    bridge_signals = None
    app_instance = None
    pin = ""

    def log_message(self, format, *args):
        pass

    def send_json(self, data, code=200):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode("utf-8"))

    def send_html(self, page, code=200):
        body = page.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_redirect(self, location, code=302):
        self.send_response(code)
        self.send_header("Location", location)
        self.send_header("Content-Length", "0")
        self.send_header("Connection", "close")
        self.end_headers()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode("utf-8") if length > 0 else ""
        params = urllib.parse.parse_qs(body)
        for k, v in urllib.parse.parse_qs(parsed.query).items():
            if k not in params:
                params[k] = v

        app = self.app_instance
        hotspot_active = is_hotspot_active() or bool(app and getattr(app, "net_ap", False))
        client_ip = self.client_address[0] if hasattr(self, "client_address") and self.client_address else ""
        is_ap_client = client_ip.startswith("10.0.0.") or client_ip.startswith("10.42.0.") or client_ip == "127.0.0.1" or (hotspot_active and not client_ip)

        if self.pin and not is_ap_client and params.get("pin", [""])[0] != self.pin:
            self.send_json({"error": "Unauthorized / Invalid PIN"}, 401)
            return

        if path == "/settings":
            self._apply_settings_update(params)
        else:
            self.send_json({"error": "Not Found"}, 404)

    def _apply_settings_update(self, params):
        app = self.app_instance
        cfg = app.config if (app and hasattr(app, "config")) else {}
        changed = {}
        restart_hotspot = False

        for key in ("HOTSPOT_SSID", "HOTSPOT_PASSWORD", "REMOTE_PIN", "MIC_VOLUME", "MUSIC_VOLUME", "MIC_ENABLED", "MIC_REVERB", "SCORING_MODE", "LYRIC_OFFSET", "OUTPUT_DEVICE"):
            if key in params:
                val = params[key][0].strip()
                if key in ("MIC_VOLUME", "MUSIC_VOLUME"):
                    try:
                        val = str(max(0, min(100, int(val))))
                    except ValueError:
                        continue
                elif key == "LYRIC_OFFSET":
                    try:
                        val = str(round(max(-2.0, min(2.0, float(val))), 2))
                    except ValueError:
                        continue
                if key in ("HOTSPOT_SSID", "HOTSPOT_PASSWORD") and cfg.get(key) != val:
                    restart_hotspot = True
                cfg[key] = val
                changed[key] = val

        # Persist to USB config if mounted, otherwise /etc/katoyos/karaoke.conf
        usb_dir = getattr(app, "songs_dir", "") if app else ""
        target_conf = None
        if usb_dir:
            u_path = Path(usb_dir)
            usb_root = u_path.parent if u_path.name in ("songs", "karaoke", "midi", "kar", "SONGS", "KARAOKE", "MIDI", "KAR") else u_path
            for name in (".katoy-karaoke.conf", "karaoke.conf", "katoy-karaoke.conf"):
                if (usb_root / name).is_file():
                    target_conf = usb_root / name
                    break
            if not target_conf and usb_root.is_dir():
                target_conf = usb_root / ".katoy-karaoke.conf"
        if not target_conf:
            target_conf = CONFIG_FILE

        if target_conf:
            try:
                lines = []
                if target_conf.is_file():
                    lines = target_conf.read_text(encoding="utf-8").splitlines()
                written_keys = set()
                new_lines = []
                for line in lines:
                    stripped = line.strip()
                    if stripped and not stripped.startswith("#") and "=" in stripped:
                        k = stripped.split("=", 1)[0].strip()
                        if k in changed:
                            new_lines.append(f"{k}={changed[k]}")
                            written_keys.add(k)
                            continue
                    new_lines.append(line)
                for k, v in changed.items():
                    if k not in written_keys:
                        new_lines.append(f"{k}={v}")
                target_conf.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
            except Exception as e:
                print(f"Error saving config to {target_conf}: {e}")

        # Apply live changes
        if app:
            if "LYRIC_OFFSET" in changed and hasattr(app, "lyric_offset"):
                try:
                    app.lyric_offset = float(changed["LYRIC_OFFSET"])
                except Exception:
                    pass
            if hasattr(app, "mic_manager") and app.mic_manager:
                try:
                    if "MIC_VOLUME" in changed:
                        app.mic_manager.set_mic_volume(int(changed["MIC_VOLUME"]))
                    if "MUSIC_VOLUME" in changed:
                        app.mic_manager.set_music_volume(int(changed["MUSIC_VOLUME"]))
                    if "OUTPUT_DEVICE" in changed:
                        app.mic_manager.set_output_device(changed["OUTPUT_DEVICE"])
                    if "MIC_ENABLED" in changed or "MIC_REVERB" in changed:
                        app.mic_manager.mic_enabled = (cfg.get("MIC_ENABLED", "1") == "1")
                        app.mic_manager.reverb_enabled = (cfg.get("MIC_REVERB", "0") == "1")
                        app.mic_manager.apply_settings()
                except Exception as e:
                    print(f"Error applying audio settings: {e}")

        if restart_hotspot:
            try:
                subprocess.Popen(["systemctl", "restart", "katoy-ap.service"])
            except Exception as e:
                print(f"Error restarting katoy-ap.service: {e}")

        self.send_json({"status": "ok", "msg": "Settings saved successfully! Hotspot restarted." if restart_hotspot else "Settings saved successfully!"})

    def _serve_settings_page(self):
        cfg = self.app_instance.config if (self.app_instance and hasattr(self.app_instance, "config")) else {}
        page = SETTINGS_HTML
        page = page.replace("__HOTSPOT_SSID__", html.escape(cfg.get("HOTSPOT_SSID", "KaraOkePi"), quote=True))
        page = page.replace("__HOTSPOT_PASSWORD__", html.escape(cfg.get("HOTSPOT_PASSWORD", "katoyos123"), quote=True))
        page = page.replace("__REMOTE_PIN__", html.escape(cfg.get("REMOTE_PIN", ""), quote=True))
