        self.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.setWordWrap(True)
        self.hide()
        self._t = QTimer(self)
        self._t.setSingleShot(True)
        self._t.timeout.connect(self.hide)

    def flash(self, msg, ms=4500):
        self.setText(msg)
        host = self.parentWidget()
        w = min(host.width() - S(120), S(1100))
        self.setFixedWidth(max(S(300), w))
        self.adjustSize()
        self.move((host.width() - self.width()) // 2, host.height() - self.height() - S(60))
        self.show()
        self.raise_()
        self._t.start(ms)


