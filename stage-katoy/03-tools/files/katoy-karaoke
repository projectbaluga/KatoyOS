def S(n):
    """Scale a 1080p design pixel to the real screen."""
    return max(1, int(round(n * UI_SCALE[0])))


def ui_font(px, weight=QFont.Weight.Normal, spacing=0.0):
    f = QFont()
    f.setFamilies(["Inter", "Noto Sans", "DejaVu Sans", "Sans Serif"])
    f.setPixelSize(S(px))
    f.setWeight(weight)
    if spacing:
        f.setLetterSpacing(QFont.SpacingType.AbsoluteSpacing, spacing)
    return f


