#!/bin/bash
# Supervisor script for KatoyOS Karaoke appliance session on display :0.
# Replaces xinit to eliminate hung xinit processes when children die.

cleanup() {
	trap - SIGTERM SIGINT EXIT
	if [ -n "$X_PID" ] && kill -0 "$X_PID" 2>/dev/null; then
		kill -TERM "$X_PID" 2>/dev/null || true
	fi
	if [ -n "$LAUNCHER_PID" ] && kill -0 "$LAUNCHER_PID" 2>/dev/null; then
		kill -TERM "$LAUNCHER_PID" 2>/dev/null || true
	fi
}

trap cleanup SIGTERM SIGINT EXIT

/usr/bin/X :0 vt1 -nocursor -nolisten tcp -noreset -quiet &
X_PID=$!

# Wait for the X11 display socket to become ready before launching client
timeout=100
while [ ! -S /tmp/.X11-unix/X0 ] && [ $timeout -gt 0 ]; do
	if ! kill -0 "$X_PID" 2>/dev/null; then
		break
	fi
	sleep 0.1
	timeout=$((timeout - 1))
done

/usr/bin/katoy-karaoke-launcher &
LAUNCHER_PID=$!

# Wait for any child process to exit
wait -n "$X_PID" "$LAUNCHER_PID" 2>/dev/null || true

# When either child exits, clean up and exit non-zero so systemd triggers Restart=always
cleanup
exit 1
