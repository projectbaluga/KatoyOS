[Unit]
Description=KatoyOS Karaoke Appliance Autostart
After=sound.target network.target graphical.target
Wants=sound.target

[Service]
Type=simple
User=katoy
Environment=DISPLAY=:0
ExecStart=/usr/bin/xinit /usr/bin/katoy-karaoke -- :0 -nocursor
Restart=always
RestartSec=2s

[Install]
WantedBy=multi-user.target
