#!/usr/bin/env python3
"""KatoyOS Welcome: first-boot setup (region, keyboard, password)."""
import subprocess
import sys
from pathlib import Path

from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (QApplication, QCheckBox, QComboBox, QFormLayout, QHBoxLayout,
                             QLabel, QLineEdit, QMessageBox, QPushButton, QStackedWidget,
                             QVBoxLayout, QWidget)

DONE = Path.home() / ".config/katoyos/welcome-done"
HELPER = ["pkexec", "/usr/lib/katoyos/helper"]


def helper(*args, stdin=None):
    r = subprocess.run(HELPER + list(args), input=stdin, text=True, capture_output=True)
    return r.returncode == 0, (r.stderr or r.stdout).strip()


def out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
    except Exception:
        return ""


def countries():
    items = []
    for line in Path("/usr/share/zoneinfo/iso3166.tab").read_text().splitlines() if Path("/usr/share/zoneinfo/iso3166.tab").exists() else []:
        if line and not line.startswith("#") and "\t" in line:
            code, name = line.split("\t", 1)
            items.append((name, code))
    return sorted(items)


def layouts():
    items, grab = [], False
    base = Path("/usr/share/X11/xkb/rules/base.lst")
    for line in base.read_text(errors="ignore").splitlines() if base.exists() else []:
        if line.startswith("! layout"):
            grab = True
            continue
        if grab and line.startswith("!"):
            break
        if grab and line.strip():
            code, _, name = line.strip().partition(" ")
            items.append((name.strip(), code))
    return sorted(items)


def page(title, body, extra=None):
    w = QWidget()
    lay = QVBoxLayout(w)
    t = QLabel(title)
    t.setStyleSheet("font-size: 22px; font-weight: 600;")
    b = QLabel(body)
    b.setWordWrap(True)
    lay.addWidget(t)
    lay.addWidget(b)
    if extra is not None:
        lay.addWidget(extra) if isinstance(extra, QWidget) else lay.addLayout(extra)
    lay.addStretch()
    return w


class Wizard(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to KatoyOS")
        self.setWindowIcon(QIcon.fromTheme("katoyos"))
        self.resize(580, 440)

        self.skip = QCheckBox("Don't show this on startup")
        self.net_btn = QPushButton("Open network setup")
        self.net_btn.clicked.connect(lambda: subprocess.Popen(["qterminal", "-e", "nmtui"]))

        self.tz, self.cc, self.kb = QComboBox(), QComboBox(), QComboBox()
        self.tz.addItem("(keep current)", "")
        cur = out(["timedatectl", "show", "-p", "Timezone", "--value"]).strip()
        for z in out(["timedatectl", "list-timezones"]).splitlines():
            self.tz.addItem(z, z)
        if cur:
            self.tz.setCurrentIndex(max(0, self.tz.findData(cur)))
        self.cc.addItem("(keep current)", "")
        for name, code in countries():
            self.cc.addItem(f"{name} ({code})", code)
        self.kb.addItem("(keep current)", "")
        for name, code in layouts():
            self.kb.addItem(f"{name} [{code}]", code)
        form = QFormLayout()
        form.addRow("Time zone", self.tz)
        form.addRow("Wi-Fi country", self.cc)
        form.addRow("Keyboard layout", self.kb)

        self.pw1, self.pw2 = QLineEdit(), QLineEdit()
        for e in (self.pw1, self.pw2):
            e.setEchoMode(QLineEdit.EchoMode.Password)
        pform = QFormLayout()
        pform.addRow("New password", self.pw1)
        pform.addRow("Repeat password", self.pw2)

        self.pages = [
            page("Welcome to KatoyOS", "A light, modern desktop made for the Raspberry Pi 3.\n\n"
                 "This quick setup takes about a minute.", self.skip),
            page("Connect to the internet", "Click the network icon in the bottom-right corner of the "
                 "screen to pick a Wi-Fi network, or plug in an Ethernet cable.\n\n"
                 "Prefer a text menu? Use the button below.", self.net_btn),
            page("Region and keyboard", "Set these so the clock, Wi-Fi and typing work as you expect.", form),
            page("Choose a password", "The default password is public knowledge. Pick your own "
                 "(at least 8 characters), or leave blank to keep the default for now.", pform),
            page("All set!", "Press Finish to apply your choices. You may be asked for your current "
                 "password once.\n\nTip: open the main menu (the K button) to find apps, and launch "
                 "KaraOkePi or run 'KatoyOS Update' now and then to get the latest fixes."),
        ]
        self.stack = QStackedWidget()
        for p in self.pages:
            self.stack.addWidget(p)
        self.back, self.next = QPushButton("Back"), QPushButton("Next")
        self.back.clicked.connect(lambda: self.go(-1))
        self.next.clicked.connect(self.on_next)
        nav = QHBoxLayout()
        nav.addWidget(self.back)
        nav.addStretch()
        nav.addWidget(self.next)
        outer = QVBoxLayout(self)
        outer.addWidget(self.stack, 1)
        outer.addLayout(nav)
        self.update_nav()

    def go(self, d):
        self.stack.setCurrentIndex(max(0, min(len(self.pages) - 1, self.stack.currentIndex() + d)))
        self.update_nav()

    def update_nav(self):
        i = self.stack.currentIndex()
        self.back.setEnabled(i > 0)
        self.next.setText("Finish" if i == len(self.pages) - 1 else "Next")

    def on_next(self):
        if self.stack.currentIndex() == len(self.pages) - 1:
            self.finish()
        else:
            self.go(1)

    def finish(self):
        a, b = self.pw1.text(), self.pw2.text()
        if a or b:
            if a != b or len(a) < 8:
                QMessageBox.warning(self, "Password", "Passwords must match and be at least 8 characters.")
                self.stack.setCurrentIndex(3)
                self.update_nav()
                return
        errors = []
        for action, value in (("set-timezone", self.tz.currentData()),
                              ("set-wifi-country", self.cc.currentData()),
                              ("set-keyboard", self.kb.currentData())):
            if value:
                ok, msg = helper(action, value)
                if not ok:
                    errors.append(f"{action}: {msg}")
                elif action == "set-keyboard":
                    subprocess.run(["setxkbmap", value])
        if a:
            ok, msg = helper("set-password", stdin=a + "\n")
            if not ok:
                errors.append(f"password: {msg}")
        if errors:
            QMessageBox.warning(self, "Some settings were not applied", "\n".join(errors))
        else:
            DONE.parent.mkdir(parents=True, exist_ok=True)
            DONE.touch()
        self.close()

    def closeEvent(self, e):
        if self.skip.isChecked():
            DONE.parent.mkdir(parents=True, exist_ok=True)
            DONE.touch()
        e.accept()


if __name__ == "__main__":
    if "--first-run" in sys.argv and DONE.exists():
        sys.exit(0)
    app = QApplication(sys.argv)
    w = Wizard()
    w.show()
    sys.exit(app.exec())
